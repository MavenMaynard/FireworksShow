    // MARK: Integration
    // -----------------------------------------------------------------

    private func stepParticles(_ dt: Double) {
        guard !particles.isEmpty else { return }

        let g = gravity
        let w = wind
        let dragK = dragUnit
        // Sparks are not free. As the field fills up, shedding thins out
        // rather than blowing the budget and starving the shells themselves.
        let load = Double(particles.count) / Double(max(1, maxParticles))
        let shedScale = quality * max(0, 1 - load * load * 1.15)
        let spark = unitH * 0.0022
        var newborn: [Particle] = []
        var write = 0

        particles.withUnsafeMutableBufferPointer { buf in
            for read in 0..<buf.count {
                var p = buf[read]
                p.age += dt
                if p.age >= p.life { continue }

                // Crossette: the star breaks into four fresh ones.
                if p.splitAge > 0 && p.age >= p.splitAge {
                    let fan = max(2, Int(p.splitFan))
                    let step = 6.2831853 / Double(fan)
                    let sp = p.splitSpeed
                    let base = atan2(p.vy, p.vx)
                    let remaining = max(0.25, p.life - p.age)
                    for k in 0..<fan {
                        var c = p
                        let a = base + Double(k) * step + rng.d(-0.10, 0.10)
                        c.vx = p.vx * 0.30 + cos(a) * sp * rng.d(0.85, 1.15)
                        c.vy = p.vy * 0.30 + sin(a) * sp * rng.d(0.85, 1.15)
                        c.age = 0
                        c.life = max(0.32, remaining * rng.d(0.75, 1.15))
                        c.size = p.size * 0.86
                        c.drag = 1.30
                        c.decay = 1.6
                        c.trail = 2
                        c.phase = rng.d(0, 6.283)
                        if p.splitsLeft > 0 {
                            // Another break is coming; make sure it lives to see it.
                            c.splitsLeft = p.splitsLeft - 1
                            c.splitAge = p.splitGap * rng.d(0.88, 1.12)
                            c.splitSpeed = sp * 0.58
                            c.life = max(c.life, c.splitAge + 0.30)
                        } else {
                            c.splitsLeft = 0
                            c.splitAge = -1
                        }
                        if p.splitHue >= 0 {
                            c.hue = p.splitHue
                            c.hue2 = -1
                            c.hueShiftAt = -1
                            c.flags.subtract(.silver)
                        }
                        newborn.append(c)
                    }
                    continue            // parent is consumed by the break
                }

                if p.jitter > 0 {
                    p.vx += rng.d(-1, 1) * p.jitter * dt
                    p.vy += rng.d(-1, 1) * p.jitter * dt
                }

                // Gravity, less the buoyancy of a star that is still burning.
                let heat = 1 - p.age / p.life
                p.vy += g * (p.grav - p.buoy * heat * heat) * dt

                // Quadratic drag, integrated semi-implicitly so it is stable
                // at any speed. This is the whole reason a shell can stop dead
                // at its burst radius and still fall like a real object: at
                // 70 m/s the braking is fierce, at walking pace it is nothing.
                // Drag acts on motion *through the air*, so a star settles at
                // the air's own speed instead of being accelerated forever.
                let air = w * p.windK
                let rvx = p.vx - air
                let sp = (rvx * rvx + p.vy * p.vy).squareRoot()
                if sp > 1e-9 {
                    let f = 1 / (1 + dragK * p.drag * sp * dt)
                    p.vx = air + rvx * f
                    p.vy *= f
                }

                p.x += p.vx * dt
                p.y += p.vy * dt

                // A glittering star drops burning grains the whole way out.
                // They hang where they fall, so the path itself draws the long
                // sparkling ray — the trail is made of debris, not of echoes.
                if p.shed > 0 && shedScale > 0.02 && p.age < p.life * 0.92 {
                    p.shedAccum += p.shed * shedScale * dt
                    while p.shedAccum >= 1 {
                        p.shedAccum -= 1
                        var k = Particle()
                        k.x = p.x + rng.d(-1, 1) * spark
                        k.y = p.y + rng.d(-1, 1) * spark
                        k.vx = p.vx * 0.10 + rng.d(-1, 1) * spark * 7
                        k.vy = p.vy * 0.10 + rng.d(-1, 1) * spark * 7
                        k.z = p.z
                        k.fs = p.fs * 0.85
                        k.life = rng.d(0.65, 1.20)
                        k.size = p.size * 0.46
                        k.hue = 0.085 + rng.d(-0.020, 0.020)
                        k.bright = rng.d(0.55, 1.05)
                        k.drag = 3.4
                        k.grav = 0.85
                        k.buoy = 0.55
                        k.windK = 1.3
                        k.decay = 1.45
                        k.phase = rng.d(0, 6.283)
                        k.rate = rng.d(18, 44)
                        // A few grains strobe hard; the rest just burn out.
                        if rng.unit() < 0.30 {
                            k.flags = [.glitter, .silver]
                        } else {
                            k.flags = [.ember]
                        }
                        newborn.append(k)
                    }
                }

                buf[write] = p
                write += 1
            }
        }

        if write < particles.count { particles.removeLast(particles.count - write) }
        if !newborn.isEmpty {
            let room = maxParticles - particles.count
            if room > 0 {
                particles.append(contentsOf: newborn.prefix(room))
            }
        }
    }

    private func stepDecor(_ dt: Double) {
        exposure *= exp(-dt * 6.0)
        if exposure < 0.0015 { exposure = 0 }

        if !flashes.isEmpty {
            var i = flashes.count - 1
            while i >= 0 {
                flashes[i].age += dt
                if flashes[i].age >= flashes[i].life { flashes.remove(at: i) }
                i -= 1
            }
        }

        if !puffs.isEmpty {
            var i = puffs.count - 1
            while i >= 0 {
                var s = puffs[i]
                s.age += dt
                if s.age >= s.life {
                    puffs.remove(at: i)
                } else {
                    // Hot and rising at first; after that it just goes where
                    // the air goes, which on a still night is almost nowhere.
                    s.vy -= gravity * 0.30 * exp(-s.age * 0.35) * dt
                    s.vx += (wind * 2.4 - s.vx) * (1 - exp(-dt * 0.45))
                    s.vy *= exp(-dt * 0.30)
                    // A slow bounded wander, so a cloud never sits dead still.
                    let wobX = sin(time * 0.23 + s.phase) * unitH * 0.005
                    let wobY = sin(time * 0.17 + s.phase * 1.7) * unitH * 0.003
                    s.x += (s.vx + wobX) * dt
                    s.y += (s.vy + wobY) * dt
                    s.lit *= exp(-dt * 1.5)
                    puffs[i] = s
                }
                i -= 1
            }
        }
    }

    private func enforceBudget() {
        let over = particles.count - maxParticles
        if over > 0 { particles.removeFirst(over) }
        if puffs.count > maxPuffs { puffs.removeFirst(puffs.count - maxPuffs) }
        if flashes.count > 48 { flashes.removeFirst(flashes.count - 48) }
    }

    // -----------------------------------------------------------------
    // MARK: Render
    // -----------------------------------------------------------------

    @inline(__always) private func hueIndex(_ h: Double) -> Int {
        var v = h - floor(h)
        v *= Double(Sprites.hueCount)
        var i = Int(v)
        if i < 0 { i = 0 }
        if i >= Sprites.hueCount { i = Sprites.hueCount - 1 }
        return i
    }

    func render(_ ctx: inout GraphicsContext, size: CGSize) {
        let w = Double(size.width)
        let h = Double(size.height)

        ctx.fill(Path(CGRect(origin: .zero, size: size)), with: .color(.black))
        guard let deck = ResolvedDeck(ctx) else { return }

        // Everything in the sky is light, so everything is additive.
        ctx.blendMode = .plusLighter

        drawStars(&ctx, deck, w, h)
        drawPuffs(&ctx, deck, w, h)
        drawParticles(&ctx, deck, w, h)
        drawRockets(&ctx, deck, w, h)
        drawWater(&ctx, deck, w, h)
        drawFlashes(&ctx, deck, w, h)

        if exposure > 0.004 {
            ctx.opacity = 1
            let a = min(0.085, exposure * 0.055)
            ctx.fill(Path(CGRect(origin: .zero, size: size)),
                     with: .color(Color(red: 1.0, green: 0.95, blue: 0.88).opacity(a)))
        }
    }

    private func drawStars(_ ctx: inout GraphicsContext, _ deck: ResolvedDeck,
                           _ w: Double, _ h: Double) {
        for s in stars {
            var sx = s.ux * w - camX * s.parallax
            sx = sx.truncatingRemainder(dividingBy: w)
            if sx < 0 { sx += w }
            let sy = s.uy * h - camY * s.parallax

            let osc = sin(time * s.rate + s.phase)
            // Sparkles wink most of the way out; plain dots breathe.
            let tw = s.glint ? (0.16 + 0.84 * pow(max(0, osc), 1.4))
                             : (0.52 + 0.48 * osc)
            var a = s.bright * tw

            // Below the horizon there is no sky, only water. A star barely
            // makes it onto the surface at all, and what does is gone within
            // a short way of the shore — so these fade hard, and shiver.
            var sxDraw = sx
            if sy > vanishY {
                let depth = min(1, (sy - vanishY) / max(1, h - vanishY))
                a *= 0.13 * pow(1 - depth, 1.6)
                sxDraw += sin(sy * 0.07 + time * 1.4 + s.phase) * (0.6 + depth * 2.4)
            }
            if a < 0.02 { continue }

            ctx.opacity = a
            if s.glint {
                let g = s.size * 2.7
                ctx.draw(deck.glint, in: CGRect(x: sxDraw - g, y: sy - g, width: g * 2, height: g * 2))
            } else {
                let r = s.size
                let sym = s.tint == 1 ? deck.starWarm : (s.tint == 2 ? deck.starCool : deck.silverCore)
                ctx.draw(sym, in: CGRect(x: sxDraw - r, y: sy - r, width: r * 2, height: r * 2))
            }
        }
    }

    private func drawPuffs(_ ctx: inout GraphicsContext, _ deck: ResolvedDeck,
                           _ w: Double, _ h: Double) {
        guard !deck.smoke.isEmpty else { return }
        // Screen radius is capped. A puff that grew without limit would eat
        // the entire fill-rate budget on its own by the time it faded out.
        let cap = unitH * 0.16
        for s in puffs {
            let f = s.age / s.life
            let env = min(1, s.age * 0.8) * pow(1 - f, 0.70)
            let a = s.density * env * (0.34 + s.lit + exposure * 0.30) * atmosphere(s.z)
            if a < 0.0035 { continue }
            let rw = min(cap, (s.r0 + s.grow * pow(f, 0.55)) * s.z)
            let rx = rw * s.aspect
            let ry = rw / s.aspect
            let sx = screenX(s.x, s.z)
            let sy = screenY(s.y, s.z)
            if sx < -rx * 1.2 || sx > w + rx * 1.2 { continue }
            if sy < -ry * 1.2 || sy > h + ry * 1.2 { continue }
            // No single puff is ever allowed to read as solid.
            ctx.opacity = min(0.55, a)
            ctx.draw(deck.smoke[Int(s.variant) % deck.smoke.count],
                     in: CGRect(x: sx - rx, y: sy - ry, width: rx * 2, height: ry * 2))
        }
    }

    /// The show is over water, so everything above the horizon gets a second,
    /// wrecked copy below it.
    ///
    /// A true mirror of a shell 150 m up would land a hair under the horizon
    /// and be invisible, so the reflection is compressed to about half depth
    /// to keep it on screen. What sells it is not the mirror anyway — it is
    /// that every reflected point is smeared into a tall vertical streak and
    /// pushed sideways by the ripple, which is exactly what a light source
    /// does on moving water.
    private func drawWater(_ ctx: inout GraphicsContext, _ deck: ResolvedDeck,
                           _ w: Double, _ h: Double) {
        let waterY = vanishY
        guard waterY < h - 8 else { return }
        let span = h - waterY
        let t = time

        // The surface itself, lit by whatever is going off above it.
        let sheen = min(0.10, 0.010 + exposure * 0.055)
        if sheen > 0.004 {
            ctx.opacity = 1
            ctx.fill(Path(CGRect(x: 0, y: waterY, width: w, height: span)),
                     with: .linearGradient(
                        Gradient(colors: [Color(red: 0.30, green: 0.40, blue: 0.62).opacity(sheen),
                                          Color.clear]),
                        startPoint: CGPoint(x: 0, y: waterY),
                        endPoint: CGPoint(x: 0, y: h)))
        }

        // Flashes throw the widest glare, and there are few of them.
        for fl in flashes {
            let u = fl.age / fl.life
            if u >= 1 { continue }
            let sy = screenY(fl.y, fl.z)
            if sy > waterY { continue }
            let ry = waterY + (waterY - sy) * 0.52
            if ry > h + 60 { continue }
            let depth = min(1, (ry - waterY) / span)
            let a = pow(1 - u, 1.9) * fl.power * 0.30 * (1 - depth * 0.40)
            if a < 0.012 { continue }
            let rr = fl.radius * fl.z * (0.50 + u * 0.80)
            let hh = rr * (2.4 + depth * 5.0)
            let rip = sin(ry * 0.050 + t * 1.7) * (2 + depth * 18)
            let sx = screenX(fl.x, fl.z) + rip
            let tint = fl.silver ? deck.silverHalo : deck.halo[hueIndex(fl.hue)]
            ctx.opacity = min(1, a)
            ctx.draw(tint, in: CGRect(x: sx - rr, y: ry - hh, width: rr * 2, height: hh * 2))
        }

        // Stars, decimated — a reflection is broken up anyway, so drawing
        // every second or third one costs nothing in believability.
        let step = quality > 0.78 ? 2 : 3
        var n = 0
        for p in particles {
            n += 1
            if n % step != 0 { continue }
            let u = p.age / p.life
            if u >= 1 { continue }

            var a = p.bright * min(1, p.age * 22) * pow(1 - u, p.decay)
            if p.flags.contains(.glitter) {
                a *= sin(t * p.rate + p.phase) > 0.45 ? 1.25 : 0.05
            }
            a *= atmosphere(p.z) * p.fs * 0.34
            if a < 0.025 { continue }

            let sy = screenY(p.y, p.z)
            if sy > waterY { continue }
            let ry = waterY + (waterY - sy) * 0.52
            if ry > h + 30 { continue }
            let depth = min(1, (ry - waterY) / span)
            let fade = a * (1 - depth * 0.50)
            if fade < 0.02 { continue }

            var hue = p.hue
            if p.flags.contains(.ember) { hue = hueLerp(hue, 0.060, min(1, pow(u, 1.4))) }
            let sym = p.flags.contains(.silver) ? deck.silverCore : deck.core[hueIndex(hue)]

            let rip = sin(ry * 0.055 + t * 2.0 + p.phase) * (1.5 + depth * 15)
            let sx = screenX(p.x, p.z) + rip
            let rr = p.size * p.z * p.fs * (0.95 + depth * 0.55)
            let hh = rr * (2.0 + depth * 5.5)
            ctx.opacity = min(1, fade)
            ctx.draw(sym, in: CGRect(x: sx - rr, y: ry - hh, width: rr * 2, height: hh * 2))
        }
    }

    private func drawParticles(_ ctx: inout GraphicsContext, _ deck: ResolvedDeck,
                               _ w: Double, _ h: Double) {
        let t = time
        let trailBudget = quality > 0.7 ? 3 : (quality > 0.5 ? 2 : 1)

        for p in particles {
            let u = p.age / p.life
            if u >= 1 { continue }

            // Fast attack, long tapered decay.
            var a = p.bright * min(1, p.age * 22) * pow(1 - u, p.decay)

            if p.flags.contains(.glitter) {
                let s = sin(t * p.rate + p.phase)
                a *= s > 0.45 ? 1.25 : 0.05
            } else if p.flags.contains(.twinkle) {
                a *= 0.48 + 0.52 * sin(t * p.rate + p.phase)
            }

            a *= atmosphere(p.z) * p.fs
            if a < 0.012 { continue }

            let sx = screenX(p.x, p.z)
            let sy = screenY(p.y, p.z)
            let r = p.size * p.z * p.fs * (1 + u * 0.18)
            let bound = r * 6
            if sx < -bound || sx > w + bound || sy < -bound || sy > h + bound { continue }

            let silver = p.flags.contains(.silver)
            var hue = p.hue
            if p.hueShiftAt > 0 && p.age > p.hueShiftAt {
                hue = hueLerp(p.hue, p.hue2, clamp01((p.age - p.hueShiftAt) / 0.22))
            }
            if p.flags.contains(.ember) {
                // Stars cool to orange as they burn out.
                hue = hueLerp(hue, 0.060, min(1, pow(u, 1.4)))
            }
            let idx = hueIndex(hue)
            let halo = silver ? deck.silverHalo : deck.halo[idx]
            let core = silver ? deck.silverCore : deck.core[idx]

            // Cheap depth of field: far shells spread into their glow and
            // lose the hard centre, near ones stay pin-sharp.
            let soft = 1 + 0.30 * clamp01((1.06 - p.z) / 0.34)

            if !p.flags.contains(.noHalo) {
                let hr = r * 3.0 * soft
                ctx.opacity = min(1, a * 0.50)
                ctx.draw(halo, in: CGRect(x: sx - hr, y: sy - hr, width: hr * 2, height: hr * 2))
            }

            if a > 0.13 {
                ctx.opacity = min(1, a * 1.15 / soft)
                ctx.draw(core, in: CGRect(x: sx - r, y: sy - r, width: r * 2, height: r * 2))
            }

            // Motion streak: a few echoes back along the velocity vector.
            if p.trail > 0 && a > 0.10 {
                let steps = min(Int(p.trail), trailBudget)
                let vxs = p.vx * p.z
                let vys = p.vy * p.z
                for k in 1...steps {
                    let f = Double(k) * 0.032
                    let ex = sx - vxs * f
                    let ey = sy - vys * f
                    let er = r * (1 - 0.18 * Double(k))
                    if er <= 0.2 { break }
                    ctx.opacity = min(1, a * 0.42 / Double(k))
                    ctx.draw(core, in: CGRect(x: ex - er, y: ey - er, width: er * 2, height: er * 2))
                }
            }
        }
    }

    private func drawRockets(_ ctx: inout GraphicsContext, _ deck: ResolvedDeck,
                             _ w: Double, _ h: Double) {
        for r in rockets {
            let sx = screenX(r.x, r.z)
            let sy = screenY(r.y, r.z)
            if sx < -60 || sx > w + 60 || sy < -60 || sy > h + 60 { continue }
            let idx = hueIndex(r.hue)
            let halo = r.silver ? deck.silverHalo : deck.halo[idx]
            let core = r.silver ? deck.silverCore : deck.core[idx]
            let rad = r.size * r.z
            let hr = rad * 4.5

            ctx.opacity = 0.55
            ctx.draw(halo, in: CGRect(x: sx - hr, y: sy - hr, width: hr * 2, height: hr * 2))
            ctx.opacity = 1.0
            ctx.draw(core, in: CGRect(x: sx - rad, y: sy - rad, width: rad * 2, height: rad * 2))

            let vxs = r.vx * r.z, vys = r.vy * r.z
            for k in 1...3 {
                let f = Double(k) * 0.022
                let er = rad * (1 - 0.2 * Double(k))
                if er <= 0.2 { break }
                ctx.opacity = 0.5 / Double(k)
                ctx.draw(core, in: CGRect(x: sx - vxs * f - er, y: sy - vys * f - er,
                                          width: er * 2, height: er * 2))
            }
        }
    }

    private func drawFlashes(_ ctx: inout GraphicsContext, _ deck: ResolvedDeck,
                             _ w: Double, _ h: Double) {
        // Four layers on their own clocks, all sized off the shell: a hard
        // white core, a four-point flare that is gone almost at once, a soft
        // coloured bloom, and a shockwave ring riding out ahead of the stars.
        for f in flashes {
            let u = f.age / f.life
            if u >= 1 { continue }
            let sx = screenX(f.x, f.z)
            let sy = screenY(f.y, f.z)
            let R = f.radius * f.z
            if sx < -R * 5 || sx > w + R * 5 || sy < -R * 5 || sy > h + R * 5 { continue }

            let tint = f.silver ? deck.silverHalo : deck.halo[hueIndex(f.hue)]

            // Bloom — the slowest of the four. Everything here is sized to
            // stay inside the star front, which only reaches about 0.4 of the
            // shell radius in the time the flash is alive. Overshoot that and
            // the break reads as a big empty halo with a small shell in it.
            let bloomA = pow(1 - u, 1.9) * f.power * 0.72
            if bloomA > 0.01 {
                let br = R * (0.12 + u * 0.52)
                ctx.opacity = min(1, bloomA)
                ctx.draw(tint, in: CGRect(x: sx - br, y: sy - br, width: br * 2, height: br * 2))
            }

            // White core — a hot point, not a headlight.
            let coreA = pow(1 - u, 3.4) * f.power
            if coreA > 0.01 {
                let cr = R * (0.030 + u * 0.045)
                ctx.opacity = min(1, coreA)
                ctx.draw(deck.flash, in: CGRect(x: sx - cr, y: sy - cr, width: cr * 2, height: cr * 2))
            }

            // Five small sparkles thrown out radially, rather than one big
            // lens flare parked on the middle.
            let flareA = pow(1 - u, 5.0) * f.power * 0.42
            if flareA > 0.02 {
                let fr = R * (0.10 + u * 0.13)
                let ring = R * (0.10 + u * 0.34)
                ctx.opacity = min(1, flareA)
                for k in 0..<5 {
                    let a = f.spin + Double(k) * 1.2566371      // 2pi / 5
                    let px = sx + cos(a) * ring
                    let py = sy + sin(a) * ring
                    ctx.draw(deck.glint, in: CGRect(x: px - fr, y: py - fr,
                                                    width: fr * 2, height: fr * 2))
                }
            }

            // Shockwave.
            let ringA = pow(1 - u, 1.5) * min(1.0, f.power) * 0.36
            if ringA > 0.01 {
                // Grows fast then eases, the same way the stars do.
                let rr = R * (0.08 + u * u * 0.26 + u * 0.38)
                ctx.opacity = min(1, ringA)
                ctx.draw(deck.shock, in: CGRect(x: sx - rr, y: sy - rr, width: rr * 2, height: rr * 2))
            }
        }
    }
}

// =====================================================================
// MARK: - Sound
//
// Every sound here is synthesised from noise and sine at startup — there
// are no audio files, because there is no second file to put them in.
// Five families: the mortar's boof, the shell's break, a sharp salute
// crack, crackling pistils and a high shimmer for twinkling stars.
//
// The good part is the distance model. You see the flash, then you hear
// it: the delay, the volume and a per-voice low-pass all come off the
// shell's depth, so far shells thud late and dull while near ones snap.
// =====================================================================

/// Chamberlin state-variable filter — gives a resonant band without much work.
struct SVFilter {
    var low: Double = 0
    var band: Double = 0
    var high: Double = 0

    /// `f` is 2·sin(π·fc/sr), `q` is damping — smaller means more resonant,
    /// and more resonant means more tonal. Keep q up for anything that should
    /// read as a tick rather than a chime. Stable while f < 2 - q.
    @inline(__always) mutating func run(_ x: Double, _ f: Double, _ q: Double) {
        high = x - low - q * band
        band += f * high
        low += f * band
    }
}

enum SoundKind: Int, CaseIterable {
    case launch = 0     // mortar thump
    case boom           // shell break
    case crack          // salute
    case crackle        // crackling pistil
    case shimmer        // glitter / strobe stars
}

final class AudioDirector {

    static let sampleRate: Double = 44100

    var enabled: Bool = true {
        didSet { if !enabled { pending.removeAll() } }
    }

    private let engine = AVAudioEngine()
    private let submix = AVAudioMixerNode()
    private let reverb = AVAudioUnitReverb()
    private var players: [AVAudioPlayerNode] = []
    private var eqs: [AVAudioUnitEQ] = []
    private var busyUntil: [Double] = []
    private var banks: [[AVAudioPCMBuffer]] = []
    private var started = false
    private var now: Double = 0
    private var rng = FastRNG(seed: 0x51ED_2701)

    private struct Pending {
        var due: Double
        var kind: SoundKind
        var volume: Double
        var pan: Double
        var cutoff: Double
    }
    private var pending: [Pending] = []

    private let voiceCount = 20

    // -----------------------------------------------------------------

    func prepare() {
        guard !started else { return }

        let session = AVAudioSession.sharedInstance()
        // .playback so the show is audible with the ring switch off, but
        // mixWithOthers so we never stop someone's music.
        try? session.setCategory(.playback, mode: .default, options: [.mixWithOthers])
        try? session.setActive(true)

        // Voices are mono so panning has something to do; everything past the
        // submix is stereo, or the pan would collapse back to the centre.
        guard let fmt = AVAudioFormat(standardFormatWithSampleRate: Self.sampleRate, channels: 1),
              let outFmt = AVAudioFormat(standardFormatWithSampleRate: Self.sampleRate, channels: 2)
        else { return }

        banks = SoundKind.allCases.map { synthesise($0, format: fmt) }

        engine.attach(submix)
        engine.attach(reverb)
        reverb.loadFactoryPreset(.largeHall2)
        reverb.wetDryMix = 24        // night air, open ground
        engine.connect(submix, to: reverb, format: outFmt)
        engine.connect(reverb, to: engine.mainMixerNode, format: outFmt)

        for _ in 0..<voiceCount {
            let node = AVAudioPlayerNode()
            let eq = AVAudioUnitEQ(numberOfBands: 1)
            if let band = eq.bands.first {
                band.filterType = .lowPass
                band.frequency = 18000
                band.bypass = false
            }
            engine.attach(node)
            engine.attach(eq)
            engine.connect(node, to: eq, format: fmt)
            engine.connect(eq, to: submix, format: fmt)
            players.append(node)
            eqs.append(eq)
            busyUntil.append(-1)
        }

        engine.prepare()
        do {
            try engine.start()
        } catch {
            enabled = false
            return
        }
        for node in players { node.play() }
        started = true
    }

    func schedule(_ kind: SoundKind, delay: Double, volume: Double, pan: Double, cutoff: Double) {
        guard started, enabled, volume > 0.02, pending.count < 120 else { return }
        pending.append(Pending(due: now + max(0, delay), kind: kind,
                               volume: volume, pan: pan, cutoff: cutoff))
    }

    func tick(_ t: Double) {
        now = t
        guard started, enabled else { return }
        guard !pending.isEmpty else { return }
        var i = pending.count - 1
        while i >= 0 {
            if pending[i].due <= t {
                fire(pending[i])
                pending.remove(at: i)
            }
            i -= 1
        }
    }

    private func fire(_ e: Pending) {
        let bank = banks[e.kind.rawValue]
        guard !bank.isEmpty else { return }

        var slot = -1
        var active = 0
        for i in 0..<players.count {
            if busyUntil[i] > now { active += 1 } else if slot < 0 { slot = i }
        }
        guard slot >= 0 else { return }     // all voices busy; let this one go

        let buf = bank[rng.i(0, bank.count - 1)]
        // Soft ducking so a finale stays loud without turning to mush.
        let duck = 1.0 / (1.0 + 0.085 * Double(active))
        let node = players[slot]
        node.volume = Float(min(1.0, e.volume * duck))
        node.pan = Float(max(-1, min(1, e.pan)))
        if let band = eqs[slot].bands.first {
            band.frequency = Float(max(220, min(18000, e.cutoff)))
        }
        node.scheduleBuffer(buf, at: nil, options: [], completionHandler: nil)
        busyUntil[slot] = now + Double(buf.frameLength) / Self.sampleRate
    }

    // -----------------------------------------------------------------
    // MARK: Synthesis
    // -----------------------------------------------------------------

    private func synthesise(_ kind: SoundKind, format: AVAudioFormat) -> [AVAudioPCMBuffer] {
        var samples: [[Float]] = []
        switch kind {
        case .launch:
            samples = [buildLaunch(seed: 11, f0: 74, dur: 0.42),
                       buildLaunch(seed: 29, f0: 62, dur: 0.46),
                       buildLaunch(seed: 47, f0: 88, dur: 0.38)]
        case .boom:
            samples = [buildBoom(seed: 101, size: 1.35, dur: 1.18, sharp: false),
                       buildBoom(seed: 137, size: 1.00, dur: 1.08, sharp: false),
                       buildBoom(seed: 173, size: 0.78, dur: 0.95, sharp: false),
                       buildBoom(seed: 211, size: 1.15, dur: 1.12, sharp: false)]
        case .crack:
            samples = [buildBoom(seed: 307, size: 0.60, dur: 0.85, sharp: true),
                       buildBoom(seed: 349, size: 0.72, dur: 0.92, sharp: true)]
        case .crackle:
            samples = [buildCrackle(seed: 401, dur: 1.15),
                       buildCrackle(seed: 433, dur: 1.05),
                       buildCrackle(seed: 467, dur: 1.25)]
        case .shimmer:
            samples = [buildShimmer(seed: 503, hz: 3800, dur: 1.50),
                       buildShimmer(seed: 541, hz: 4600, dur: 1.40),
                       buildShimmer(seed: 587, hz: 5400, dur: 1.60)]
        }
        return samples.compactMap { pcm($0, format: format) }
    }

    private func pcm(_ data: [Float], format: AVAudioFormat) -> AVAudioPCMBuffer? {
        guard let buf = AVAudioPCMBuffer(pcmFormat: format,
                                         frameCapacity: AVAudioFrameCount(data.count)),
              let ch = buf.floatChannelData else { return nil }
        buf.frameLength = AVAudioFrameCount(data.count)
        let dst = ch[0]
        for i in 0..<data.count { dst[i] = data[i] }
        return buf
    }

    /// Non-feedback echo taps — the sky answering back off nothing in particular.
    private func addTaps(_ buf: inout [Float], _ taps: [(Double, Double)]) {
        let src = buf
        for (delay, gain) in taps {
            let d = Int(delay * Self.sampleRate)
            if d <= 0 || d >= buf.count { continue }
            let g = Float(gain)
            for i in 0..<(buf.count - d) { buf[i + d] += src[i] * g }
        }
    }

    /// The mortar: a pitch-dropping thump with a powder chuff over the top.
    private func buildLaunch(seed: UInt64, f0: Double, dur: Double) -> [Float] {
        let sr = Self.sampleRate
        let n = Int(dur * sr)
        var out = [Float](repeating: 0, count: n)
        var r = FastRNG(seed: seed)
        var lpLow = 0.0, lpMid = 0.0, phase = 0.0
        let aLow = 1 - exp(-2 * Double.pi * 300 / sr)
        let aMid = 1 - exp(-2 * Double.pi * 1200 / sr)
        for i in 0..<n {
            let t = Double(i) / sr
            let f = f0 * (0.52 + 0.48 * exp(-t * 9))
            phase += 2 * Double.pi * f / sr
            let thump = sin(phase) * exp(-t * 7.0)
            let white = r.d(-1, 1)
            lpLow += (white - lpLow) * aLow
            lpMid += (white - lpMid) * aMid
            let air = lpLow * exp(-t * 10.0) * 1.5
            let chuff = (lpMid - lpLow) * exp(-t * 24.0) * 0.8
            var v = thump * 0.95 + air + chuff
            v *= min(1, t * 800)
            out[i] = Float(tanh(v * 1.3) * 0.55)
        }
        addTaps(&out, [(0.075, 0.22), (0.155, 0.11)])
        return out
    }

    /// The break: transient crack, low body, sub thump, long rumble.
    private func buildBoom(seed: UInt64, size: Double, dur: Double, sharp: Bool) -> [Float] {
        let sr = Self.sampleRate
        let n = Int(dur * sr)
        var out = [Float](repeating: 0, count: n)
        var r = FastRNG(seed: seed)
        var lpBody = 0.0, lpTail = 0.0, phase = 0.0
        var sv = SVFilter()
        let aBody = 1 - exp(-2 * Double.pi * (200 / size) / sr)
        let aTail = 1 - exp(-2 * Double.pi * (820 / size) / sr)
        let fCrack = 2 * sin(Double.pi * (sharp ? 2500 : 1400) / sr)
        let subHz = 50 / size
        let crackDecay = sharp ? 85.0 : 44.0
        let bodyDecay = sharp ? 7.5 : 3.4
        for i in 0..<n {
            let t = Double(i) / sr
            let white = r.d(-1, 1)
            lpBody += (white - lpBody) * aBody
            lpTail += (white - lpTail) * aTail
            sv.run(white, fCrack, 0.35)
            let crack = sv.band * exp(-t * crackDecay) * (sharp ? 1.6 : 0.85)
            let body = lpBody * exp(-t * bodyDecay) * 2.8
            let tail = lpTail * exp(-t * 1.45) * 0.45
            phase += 2 * Double.pi * (subHz * (0.6 + 0.4 * exp(-t * 4))) / sr
            let sub = sin(phase) * exp(-t * 4.2) * 0.75
            var v = crack + body + tail + sub
            v *= min(1, t * 2200)
            out[i] = Float(tanh(v) * 0.5)
        }
        addTaps(&out, [(0.088, 0.30), (0.171, 0.18), (0.262, 0.10)])
        return out
    }

    /// Crackling pistil: a thinning train of tiny resonant pops.
    private func buildCrackle(seed: UInt64, dur: Double) -> [Float] {
        let sr = Self.sampleRate
        let n = Int(dur * sr)
        var out = [Float](repeating: 0, count: n)
        var r = FastRNG(seed: seed)
        let grain = Int(sr * 0.018)
        var t = 0.015
        while t < dur {
            let density = 265 * exp(-t * 1.15)
            t += r.d(0.35, 1.9) / max(8, density)
            let start = Int(t * sr)
            if start + 2 >= n { break }
            let amp = r.d(0.25, 1.0) * exp(-t * 0.9)
            let f = min(1.30, 2 * sin(Double.pi * r.d(1500, 5200) / sr))
            let dec = r.d(260, 620)
            let bite = r.d(0.30, 0.85)
            var sv = SVFilter()
            let len = min(grain, n - start)
            for j in 0..<len {
                let tt = Double(j) / sr
                // Damped wide, so each one snaps rather than pings.
                sv.run(r.d(-1, 1), f, 0.55)
                let g = (sv.band + sv.high * bite) * exp(-tt * dec)
                out[start + j] += Float(g * amp * 0.40)
            }
        }
        addTaps(&out, [(0.095, 0.22), (0.185, 0.12)])
        return out
    }

    /// The sparkle of glittering stars: a dense sizzle of tiny sharp pops
    /// that thins into a string of separate cracks, like a fuse of small
    /// firecrackers running out.
    ///
    /// Deliberately broadband. The first version of this used clean sine
    /// pings, which is exactly how you build a wind chime — a resonant
    /// partial with a long ring is a musical note, not a spark. Here every
    /// grain is noise through a wide, heavily damped filter with some raw
    /// high end riding along, and it dies in a couple of milliseconds.
    private func buildShimmer(seed: UInt64, hz: Double, dur: Double) -> [Float] {
        let sr = Self.sampleRate
        let n = Int(dur * sr)
        var out = [Float](repeating: 0, count: n)
        var r = FastRNG(seed: seed)

        // The pops. Dense enough at the start to merge into a roar, thinning
        // to countable cracks by the end.
        let grain = Int(sr * 0.007)
        var t = 0.008
        while t < dur {
            let density = 640 * exp(-t * 1.7)
            t += r.d(0.25, 2.2) / max(25, density)
            let start = Int(t * sr)
            if start + 2 >= n { break }
            let amp = r.d(0.12, 1.0) * exp(-t * 1.25)
            let fc = min(9000, r.d(hz * 0.40, hz * 1.55))
            let f = min(1.30, 2 * sin(Double.pi * fc / sr))
            let q = r.d(0.42, 0.85)          // wide, so it ticks instead of rings
            let dec = r.d(450, 1500)         // gone in 1-2 ms
            let bite = r.d(0.25, 0.70)       // raw high end mixed in
            var sv = SVFilter()
            let len = min(grain, n - start)
            for j in 0..<len {
                let tt = Double(j) / sr
                sv.run(r.d(-1, 1), f, q)
                let g = (sv.band + sv.high * bite) * exp(-tt * dec)
                out[start + j] += Float(g * amp * 0.34)
            }
        }

        // A thin sizzle underneath so the gaps never sound gated or synthetic.
        var bed = SVFilter()
        var mod = 0.5
        let fBed = min(1.30, 2 * sin(Double.pi * min(7000, hz * 0.85) / sr))
        let aMod = 1 - exp(-2 * Double.pi * 26 / sr)
        for i in 0..<n {
            let tt = Double(i) / sr
            bed.run(r.d(-1, 1), fBed, 0.85)
            mod += (r.unit() - mod) * aMod
            let env = min(1, tt * 9) * exp(-tt * 2.4)
            out[i] += Float(bed.band * env * (0.15 + 0.85 * mod * mod) * 0.13)
        }

        addTaps(&out, [(0.085, 0.20), (0.163, 0.10)])
        return out
    }
}
