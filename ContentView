}

// =====================================================================
// MARK: - Show cadence (shared by the engine and the readout)
// =====================================================================

enum Show {

    /// Seconds between volleys for a normalised energy `e`.
    static func interval(_ e: Double) -> Double { 4.6 * pow(1 - e, 2.2) + 0.28 }

    /// Average shells per volley.
    static func volley(_ e: Double) -> Double { 1 + 2.2 * e * e }

    /// Slider position → normalised energy.
    static func energy(_ intensity: Double) -> Double { pow(clamp01(intensity), 0.85) }

    static func name(for v: Double) -> String {
        if v <= 0.02 { return "DARK" }
        if v < 0.12 { return "EMBER" }
        if v < 0.28 { return "DRIFT" }
        if v < 0.46 { return "RISE" }
        if v < 0.64 { return "SWELL" }
        if v < 0.80 { return "BARRAGE" }
        if v < 0.93 { return "STORM" }
        return "FINALE"
    }

    static func rateText(for v: Double) -> String {
        guard v > 0.02 else { return "—" }
        let e = energy(v)
        let perMinute = Int((60.0 / interval(e)) * volley(e))
        return "\(perMinute) shells / min"
    }

    static func glow(for v: Double) -> Color {
        Color(hue: 0.60 - 0.52 * clamp01(v), saturation: 0.85, brightness: 1.0)
    }

    static var trackColors: [Color] {
        [Color(red: 0.20, green: 0.42, blue: 1.00),
         Color(red: 0.62, green: 0.34, blue: 1.00),
         Color(red: 1.00, green: 0.30, blue: 0.62),
         Color(red: 1.00, green: 0.58, blue: 0.18),
         Color(red: 1.00, green: 0.92, blue: 0.66)]
    }
}

@inline(__always) func clamp01(_ v: Double) -> Double { v < 0 ? 0 : (v > 1 ? 1 : v) }

// =====================================================================
// MARK: - Fast deterministic RNG (xorshift128+)
// =====================================================================

struct FastRNG {
    private var s0: UInt64
    private var s1: UInt64

    init(seed: UInt64) {
        s0 = (seed &* 0xBF58476D1CE4E5B9) | 1
        s1 = (seed &* 0x94D049BB133111EB) | 1
    }

    @inline(__always) mutating func next() -> UInt64 {
        var x = s0
        let y = s1
        s0 = y
        x ^= x << 23
        x ^= x >> 17
        x ^= y
        x ^= y >> 26
        s1 = x
        return s0 &+ s1
    }

    /// Uniform in [0, 1).
    @inline(__always) mutating func unit() -> Double {
        Double(next() >> 11) * (1.0 / 9007199254740992.0)
    }
    @inline(__always) mutating func d(_ a: Double, _ b: Double) -> Double { a + (b - a) * unit() }
    @inline(__always) mutating func i(_ a: Int, _ b: Int) -> Int {
        if b <= a { return a }
        return a + Int(next() % UInt64(b - a + 1))
    }
    @inline(__always) mutating func chance(_ p: Double) -> Bool { unit() < p }
    /// ±1 with equal odds.
    @inline(__always) mutating func sign() -> Double { unit() < 0.5 ? -1 : 1 }
}

// =====================================================================
// MARK: - Small 3D helper (shells are generated in 3D, projected to 2.5D)
// =====================================================================

struct V3 {
    var x: Double, y: Double, z: Double
}

@inline(__always) func cross(_ a: V3, _ b: V3) -> V3 {
    V3(x: a.y * b.z - a.z * b.y,
       y: a.z * b.x - a.x * b.z,
       z: a.x * b.y - a.y * b.x)
}

@inline(__always) func normalized(_ a: V3) -> V3 {
    let m = max(1e-9, (a.x * a.x + a.y * a.y + a.z * a.z).squareRoot())
    return V3(x: a.x / m, y: a.y / m, z: a.z / m)
}

/// Shortest-path hue interpolation (hues live on a circle).
@inline(__always) func hueLerp(_ a: Double, _ b: Double, _ t: Double) -> Double {
    var d = b - a
    if d > 0.5 { d -= 1 } else if d < -0.5 { d += 1 }
    let h = a + d * t
    return h - floor(h)
}

// =====================================================================
// MARK: - Figures
//
// A pattern shell is just a list of points that become star directions.
// Parts can be flagged as detail (eyes, mouth, whiskers) so they burn in a
// second colour. Coordinates run about -1...1 with y pointing down, the
// same way the screen does.
// =====================================================================

struct Outline {
    var pts: [(Double, Double)] = []
    var detail: [Bool] = []

    mutating func reserve(_ n: Int) {
        pts.reserveCapacity(n + 24)
        detail.reserveCapacity(n + 24)
    }

    mutating func add(_ x: Double, _ y: Double, _ d: Bool) {
        pts.append((x, y))
        detail.append(d)
    }

    mutating func arc(_ cx: Double, _ cy: Double, _ r: Double,
                      _ a0: Double, _ a1: Double, _ n: Int, _ d: Bool = false) {
        let c = max(2, n)
        for i in 0..<c {
            let a = a0 + (a1 - a0) * Double(i) / Double(c)
            add(cx + cos(a) * r, cy + sin(a) * r, d)
        }
    }

    mutating func ring(_ cx: Double, _ cy: Double, _ r: Double, _ n: Int, _ d: Bool = false) {
        arc(cx, cy, r, 0, 6.2831853, n, d)
    }

    mutating func line(_ x0: Double, _ y0: Double, _ x1: Double, _ y1: Double,
                       _ n: Int, _ d: Bool = false) {
        let c = max(2, n)
        for i in 0..<c {
            let f = Double(i) / Double(c - 1)
            add(x0 + (x1 - x0) * f, y0 + (y1 - y0) * f, d)
        }
    }

    /// Ellipse, optionally rotated — toes and muzzles are not circles.
    mutating func ellipse(_ cx: Double, _ cy: Double, _ rx: Double, _ ry: Double,
                          _ rot: Double, _ n: Int, _ d: Bool = false) {
        let c = max(3, n)
        let cr = cos(rot), sr = sin(rot)
        for i in 0..<c {
            let a = Double(i) / Double(c) * 6.2831853
            let ex = cos(a) * rx
            let ey = sin(a) * ry
            add(cx + ex * cr - ey * sr, cy + ex * sr + ey * cr, d)
        }
    }

    static func part(_ n: Int, _ f: Double) -> Int { max(2, Int(Double(n) * f)) }

    // MARK: the figures

    static func heart(_ o: inout Outline, _ n: Int) {
        let c = max(12, n)
        for i in 0..<c {
            let t = Double(i) / Double(c) * 6.2831853
            let s = sin(t)
            let px = 16 * s * s * s
            let py = 13 * cos(t) - 5 * cos(2 * t) - 2 * cos(3 * t) - cos(4 * t)
            o.add(px / 17.0, -py / 17.0, false)
        }
    }

    static func star5(_ o: inout Outline, _ n: Int) {
        var v: [(Double, Double)] = []
        for i in 0..<10 {
            let a = -Double.pi / 2 + Double(i) * Double.pi / 5
            let r = (i % 2 == 0) ? 1.0 : 0.42
            v.append((r * cos(a), r * sin(a)))
        }
        let c = max(12, n)
        for i in 0..<c {
            let u = Double(i) / Double(c) * 10
            let e = Int(u) % 10
            let f = u - floor(u)
            let a = v[e], b = v[(e + 1) % 10]
            o.add(a.0 + (b.0 - a.0) * f, a.1 + (b.1 - a.1) * f, false)
        }
    }

    static func flower(_ o: inout Outline, _ n: Int, petals: Int) {
        let p = Double(petals)
        let c = max(12, n)
        for i in 0..<c {
            let t = Double(i) / Double(c) * 6.2831853
            let r = 0.55 + 0.45 * cos(p * t)
            o.add(r * cos(t), r * sin(t), false)
        }
    }

    static func cat(_ o: inout Outline, _ n: Int) {
        o.ring(0, 0.06, 0.70, part(n, 0.40))
        let ear = part(n, 0.055)
        o.line(-0.62, -0.32, -0.50, -0.98, ear)
        o.line(-0.50, -0.98, -0.14, -0.62, ear)
        o.line( 0.62, -0.32,  0.50, -0.98, ear)
        o.line( 0.50, -0.98,  0.14, -0.62, ear)
        o.ring(-0.28, -0.06, 0.085, part(n, 0.035), true)
        o.ring( 0.28, -0.06, 0.085, part(n, 0.035), true)
        o.ring( 0.00,  0.16, 0.065, part(n, 0.030), true)
        let w = part(n, 0.035)
        o.line(-0.18, 0.20, -0.92, 0.06, w, true)
        o.line(-0.18, 0.24, -0.92, 0.30, w, true)
        o.line(-0.18, 0.28, -0.88, 0.52, w, true)
        o.line( 0.18, 0.20,  0.92, 0.06, w, true)
        o.line( 0.18, 0.24,  0.92, 0.30, w, true)
        o.line( 0.18, 0.28,  0.88, 0.52, w, true)
    }

    static func smiley(_ o: inout Outline, _ n: Int) {
        o.ring(0, 0, 0.88, part(n, 0.52))
        o.ring(-0.32, -0.26, 0.10, part(n, 0.06), true)
        o.ring( 0.32, -0.26, 0.10, part(n, 0.06), true)
        // y points down, so this arc sweeps under the face: a smile.
        o.arc(0, -0.06, 0.55, 0.42, 2.72, part(n, 0.30), true)
    }

    /// Four lobes and a shaft. Each lobe runs from where the shaft meets it,
    /// right around the outside, to the waist — so the ends are genuinely
    /// round rather than two arcs with a gap between them. The pair at each
    /// end are joined by a shallow concave waist, which is the detail that
    /// makes an end read as an end instead of a bowtie.
    static func bone(_ o: inout Outline, _ n: Int) {
        let p = Double.pi
        let r = 0.215
        let lobe = part(n, 0.140)
        o.arc(-0.755, -0.315, r,  0.028 * p, -1.278 * p, lobe)
        o.arc(-0.755,  0.315, r, -0.028 * p,  1.278 * p, lobe)
        o.arc( 0.755, -0.315, r,  0.972 * p,  2.278 * p, lobe)
        o.arc( 0.755,  0.315, r, -0.972 * p, -2.278 * p, lobe)
        // The waist: an arc of a much larger circle, bulging inward.
        let waist = part(n, 0.048)
        o.arc(-1.370, 0, 0.500, -0.0972 * p, 0.0972 * p, waist)
        o.arc( 1.370, 0, 0.500,  0.9028 * p, 1.0972 * p, waist)
        let bar = part(n, 0.172)
        o.line(-0.541, -0.296, 0.541, -0.296, bar)
        o.line(-0.541,  0.296, 0.541,  0.296, bar)
    }

    /// Dog paw: four toes over a rounded-triangle pad.
    static func paw(_ o: inout Outline, _ n: Int) {
        let c = part(n, 0.38)
        for i in 0..<c {
            let t = Double(i) / Double(c) * 6.2831853
            let rr = 0.60 * (1 + 0.26 * cos(3 * (t + Double.pi / 2)))
            o.add(rr * cos(t), 0.36 + rr * sin(t) * 0.72, false)
        }
        o.ellipse(-0.31, -0.62, 0.210, 0.270,  0.00, part(n, 0.15), true)
        o.ellipse( 0.31, -0.62, 0.210, 0.270,  0.00, part(n, 0.15), true)
        o.ellipse(-0.74, -0.30, 0.185, 0.235, -0.38, part(n, 0.13), true)
        o.ellipse( 0.74, -0.30, 0.185, 0.235,  0.38, part(n, 0.13), true)
    }

    /// Bear: round head, round ears, and a face.
    static func bear(_ o: inout Outline, _ n: Int) {
        o.ellipse(-0.72, -0.86, 0.243, 0.243, 0, part(n, 0.105))
        o.ellipse( 0.72, -0.86, 0.243, 0.243, 0, part(n, 0.105))
        o.ellipse( 0.00,  0.00, 1.000, 0.818, 0, part(n, 0.37))
        o.ellipse( 0.00,  0.377, 0.433, 0.182, 0, part(n, 0.19), true)
        o.ellipse( 0.00,  0.344, 0.150, 0.069, 0, part(n, 0.10), true)
        o.ellipse(-0.365, 0.053, 0.090, 0.090, 0, part(n, 0.055), true)
        o.ellipse( 0.365, 0.053, 0.090, 0.090, 0, part(n, 0.055), true)
    }

    static func peace(_ o: inout Outline, _ n: Int) {
        o.ring(0, 0, 0.92, part(n, 0.46))
        o.line(0, -0.92, 0, 0.92, part(n, 0.20))
        o.line(0,  0.04, -0.64, 0.68, part(n, 0.17))
        o.line(0,  0.04,  0.64, 0.68, part(n, 0.17))
    }

    /// Stick figure, arms thrown up.
    static func person(_ o: inout Outline, _ n: Int) {
        o.ring(0, -0.68, 0.19, part(n, 0.16))
        o.line(0, -0.49, 0,  0.22, part(n, 0.16))
        o.line(0, -0.32, -0.60, -0.84, part(n, 0.14))
        o.line(0, -0.32,  0.60, -0.84, part(n, 0.14))
        o.line(0,  0.22, -0.46, 0.94, part(n, 0.20))
        o.line(0,  0.22,  0.46, 0.94, part(n, 0.20))
    }
}

