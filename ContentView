//
//  ContentView.swift
//  Parallax Fireworks — a 2.5D GPU-accelerated particle fireworks show.
//
//  Pure SwiftUI. Single file. Canvas + TimelineView, no Metal, no UIKit.
//  One slider controls the whole show: OFF → lone shells → full finale.
//  Everything else (shell type, palette, shape, depth, effects) is RNG.
//
//  Target: iOS 26
//

import SwiftUI
import AVFoundation

// =====================================================================
// MARK: - Root
// =====================================================================

struct ContentView: View {

    @State private var engine = FireworksEngine()
    @State private var intensity: Double = 0.32
    @State private var showUI = true
    @State private var scrubbing = false
    @State private var idleTick = 0
    @State private var showHint = true
    @State private var soundOn = true

    var body: some View {
        ZStack(alignment: .bottom) {

            Color.black.ignoresSafeArea()

            SkyView(engine: engine, intensity: intensity, soundOn: soundOn)
                .ignoresSafeArea()
                .contentShape(Rectangle())
                .onTapGesture(count: 1, coordinateSpace: .local) { point in
                    engine.requestManualShell(at: point)
                    reveal()
                }
                .gesture(
                    DragGesture(minimumDistance: 8, coordinateSpace: .local)
                        .onChanged { value in
                            engine.setDrag(dx: Double(value.translation.width),
                                           dy: Double(value.translation.height))
                        }
                        .onEnded { _ in engine.endDrag() }
                )

            if showHint {
                Text("drag the sky  ·  tap to launch")
                    .font(.system(size: 12, weight: .medium, design: .rounded))
                    .tracking(2.0)
                    .foregroundStyle(Color.white.opacity(0.28))
                    .padding(.bottom, 132)
                    .allowsHitTesting(false)
                    .transition(.opacity)
            }

            if showUI {
                ControlDeck(intensity: $intensity, scrubbing: $scrubbing, soundOn: $soundOn)
                    .transition(.move(edge: .bottom).combined(with: .opacity))
            }
        }
        .preferredColorScheme(.dark)
        .statusBarHidden()
        .persistentSystemOverlays(.hidden)
        .task(id: "\(idleTick)-\(scrubbing)") {
            try? await Task.sleep(nanoseconds: 5_000_000_000)
            if Task.isCancelled { return }
            if !scrubbing {
                withAnimation(.easeInOut(duration: 0.75)) { showUI = false }
            }
        }
        .task {
            try? await Task.sleep(nanoseconds: 7_000_000_000)
            if Task.isCancelled { return }
            withAnimation(.easeInOut(duration: 1.2)) { showHint = false }
        }
        .task {
            // Let the first frames land before we spend a moment synthesising
            // the sound banks.
            try? await Task.sleep(nanoseconds: 300_000_000)
            if Task.isCancelled { return }
            engine.prepareAudio()
        }
        .onChange(of: soundOn) { _, _ in idleTick &+= 1 }
    }

    private func reveal() {
        withAnimation(.spring(response: 0.42, dampingFraction: 0.86)) { showUI = true }
        idleTick &+= 1
    }
}

// =====================================================================
// MARK: - The sky (Canvas + TimelineView)
// =====================================================================

struct SkyView: View {

    let engine: FireworksEngine
    let intensity: Double
    let soundOn: Bool

    var body: some View {
        TimelineView(.animation) { timeline in
            Canvas(opaque: true, colorMode: .nonLinear, rendersAsynchronously: false) { ctx, size in
                engine.intensity = intensity
                engine.soundEnabled = soundOn
                engine.advance(to: timeline.date, size: size)
                engine.render(&ctx, size: size)
            } symbols: {
                // Every sprite the show can draw, rasterized once by SwiftUI
                // and then blitted thousands of times per frame. This is what
                // keeps the particle count high and the frame time low.
                ForEach(0..<Sprites.hueCount, id: \.self) { i in
                    GlowSprite(color: Sprites.color(i)).tag(Sprites.haloID(i))
                    CoreSprite(color: Sprites.color(i)).tag(Sprites.coreID(i))
                }
                GlowSprite(color: Sprites.silver).tag(Sprites.silverHaloID)
                CoreSprite(color: Sprites.silver).tag(Sprites.silverCoreID)
                FlashSprite().tag(Sprites.flashID)
                CoreSprite(color: Sprites.starWarm).tag(Sprites.starWarmID)
                CoreSprite(color: Sprites.starCool).tag(Sprites.starCoolID)
                GlintSprite().tag(Sprites.glintID)
                ShockSprite().tag(Sprites.shockID)
                ForEach(0..<Sprites.smokeVariants, id: \.self) { i in
                    SmokeCloudSprite(variant: i).tag(Sprites.smokeID(i))
                }
            }
        }
    }
}

