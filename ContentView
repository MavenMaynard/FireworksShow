struct PFlags: OptionSet {
    let rawValue: UInt16
    static let twinkle = PFlags(rawValue: 1 << 0)   // gentle shimmer
    static let glitter = PFlags(rawValue: 1 << 1)   // hard on/off strobe
    static let ember   = PFlags(rawValue: 1 << 2)   // colour falls to orange as it dies
    static let silver  = PFlags(rawValue: 1 << 3)   // white/silver star
    static let jitter  = PFlags(rawValue: 1 << 4)   // crackling, darting motion
    static let noHalo  = PFlags(rawValue: 1 << 5)   // core only (cheap, for dense fills)
