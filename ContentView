/// A four-point sparkle: long spikes, short waist, faded with a radial ramp
/// so the tips dissolve instead of ending in hard points.
struct GlintShape: Shape {
    func path(in rect: CGRect) -> Path {
        let cx = Double(rect.midX), cy = Double(rect.midY)
        let big = Double(min(rect.width, rect.height)) * 0.5
        let small = big * 0.13
        var p = Path()
        for i in 0..<8 {
            let a = Double(i) * (Double.pi / 4) - Double.pi / 2
            let r = (i % 2 == 0) ? big : small
            let pt = CGPoint(x: cx + cos(a) * r, y: cy + sin(a) * r)
            if i == 0 { p.move(to: pt) } else { p.addLine(to: pt) }
        }
        p.closeSubpath()
        return p
    }
}

