/// A cloud of powder smoke, built once and then blitted thousands of times.
///
/// The texture is Worley-flavoured: seeds are scattered on a jittered grid
/// inside a disc, in two octaves, and each becomes a soft blob a little wider
/// than the grid spacing. They overlap into one continuous lump rather than
/// reading as separate bubbles, which is what smoke actually looks like. The
/// whole thing is masked back to nothing well inside the frame, so the sprite
/// never shows a seam and nothing has to tile.
struct SmokeCloudSprite: View {

    struct Cell: Identifiable {
        let id: Int
        var x: Double, y: Double, r: Double, a: Double
    }

    private let cells: [Cell]
    private let span: Double = 168

    init(variant: Int) {
        var rng = FastRNG(seed: UInt64(variant &+ 1) &* 0x9E37_79B9_7F4A_7C15)
        var out: [Cell] = []
        var next = 0

        func octave(_ n: Int, _ maxC: Double, _ rLo: Double, _ rHi: Double,
                    _ aLo: Double, _ aHi: Double, _ keep: Double) {
            let sp = 1.0 / Double(n)
            for gy in 0..<n {
                for gx in 0..<n {
                    if rng.unit() > keep { continue }
                    let x = (Double(gx) + 0.5) * sp - 0.5 + rng.d(-0.5, 0.5) * sp
                    let y = (Double(gy) + 0.5) * sp - 0.5 + rng.d(-0.5, 0.5) * sp
                    let d = (x * x + y * y).squareRoot()
                    if d > maxC { continue }
                    // thinner toward the rim, so the cloud has a core
                    let t = d / maxC
                    let fall = 1 - 0.40 * t * t
                    out.append(Cell(id: next, x: x, y: y,
                                    r: sp * rng.d(rLo, rHi),
                                    a: rng.d(aLo, aHi) * fall))
                    next += 1
                }
            }
        }

        octave(7,  0.27, 1.15, 1.70, 0.100, 0.170, 1.00)
        octave(11, 0.30, 1.00, 1.50, 0.055, 0.105, 0.72)
        cells = out
    }

    var body: some View {
        ZStack {
            ForEach(cells) { c in
                Circle()
                    .fill(
                        RadialGradient(
                            stops: [
                                .init(color: Sprites.smokeTint.opacity(c.a), location: 0.00),
                                .init(color: Sprites.smokeTint.opacity(c.a * 0.62), location: 0.42),
                                .init(color: Sprites.smokeTint.opacity(c.a * 0.20), location: 0.72),
                                .init(color: Color.clear, location: 1.00)
                            ],
                            center: .center, startRadius: 0,
                            endRadius: CGFloat(c.r * span)
                        )
                    )
                    .frame(width: CGFloat(c.r * 2 * span), height: CGFloat(c.r * 2 * span))
                    .offset(x: CGFloat(c.x * span), y: CGFloat(c.y * span))
            }
        }
        .frame(width: CGFloat(span), height: CGFloat(span))
        .compositingGroup()
        .mask(
            RadialGradient(
                stops: [
                    .init(color: Color.white, location: 0.00),
                    .init(color: Color.white, location: 0.74),
                    .init(color: Color.white.opacity(0.55), location: 0.89),
                    .init(color: Color.clear, location: 1.00)
                ],
                center: .center, startRadius: 0, endRadius: CGFloat(span * 0.5)
            )
        )
    }
}

