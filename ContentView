/// All symbols resolved once per frame, so the hot loop is pure blitting.
struct ResolvedDeck {
    var halo: [GraphicsContext.ResolvedSymbol] = []
    var core: [GraphicsContext.ResolvedSymbol] = []
    var silverHalo: GraphicsContext.ResolvedSymbol
    var silverCore: GraphicsContext.ResolvedSymbol
    var smoke: GraphicsContext.ResolvedSymbol
    var flash: GraphicsContext.ResolvedSymbol

    init?(_ ctx: GraphicsContext) {
        guard let sh = ctx.resolveSymbol(id: Sprites.silverHaloID),
              let sc = ctx.resolveSymbol(id: Sprites.silverCoreID),
              let sm = ctx.resolveSymbol(id: Sprites.smokeID),
              let fl = ctx.resolveSymbol(id: Sprites.flashID) else { return nil }
        silverHalo = sh; silverCore = sc; smoke = sm; flash = fl
        halo.reserveCapacity(Sprites.hueCount)
        core.reserveCapacity(Sprites.hueCount)
        for i in 0..<Sprites.hueCount {
            guard let h = ctx.resolveSymbol(id: Sprites.haloID(i)),
                  let c = ctx.resolveSymbol(id: Sprites.coreID(i)) else { return nil }
            halo.append(h); core.append(c)
        }
    }
}

