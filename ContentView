struct PFlags: OptionSet {
    let rawValue: UInt16
    static let twinkle = PFlags(rawValue: 1 << 0)   // gentle shimmer
    static let glitter = PFlags(rawValue: 1 << 1)   // hard on/off strobe
    static let ember   = PFlags(rawValue: 1 << 2)   // colour falls to orange as it dies
    static let silver  = PFlags(rawValue: 1 << 3)   // white/silver star
    static let jitter  = PFlags(rawValue: 1 << 4)   // crackling, darting motion
    static let noHalo  = PFlags(rawValue: 1 << 5)   // core only (cheap, for dense fills)
}

/// A single burning star. Positions/velocities are in world units; `z` is the
/// projection depth and `fs` the 3D foreshortening of this particular star.
struct Particle {
    var x: Double = 0, y: Double = 0
    var vx: Double = 0, vy: Double = 0
    var z: Double = 1          // projection depth of the parent shell
    var fs: Double = 1         // size/brightness scale from the 3rd dimension
    var age: Double = 0
    var life: Double = 1
    var size: Double = 2       // world radius
    var hue: Double = 0.1
    var bright: Double = 1
    var drag: Double = 1.0
    var grav: Double = 1
    var buoy: Double = 0.30    // hot stars resist sinking while they burn
    var windK: Double = 1
    var decay: Double = 1.7    // brightness falloff exponent
    var phase: Double = 0
    var rate: Double = 14
    var splitAge: Double = -1  // crossette break
    var splitSpeed: Double = 0
    var splitHue: Double = -1
    var splitsLeft: UInt8 = 0  // further breaks after this one
    var splitGap: Double = 0.45
    var splitFan: UInt8 = 4
    var hue2: Double = -1      // colour it burns through to
    var hueShiftAt: Double = -1
    var jitter: Double = 0
    var shed: Double = 0       // sparks per second dropped along the path
    var shedAccum: Double = 0
    var trail: UInt8 = 0
    var flags: PFlags = []
}

struct Rocket {
    var x: Double = 0, y: Double = 0
    var vx: Double = 0, vy: Double = 0
    var z: Double = 1
    var fuse: Double = 1
    var hue: Double = 0.09
    var silver: Bool = false
    var size: Double = 3
    var trailAccum: Double = 0
    var trailRate: Double = 110
    var apex: Bool = true
    var plan = ShellPlan()
}

/// Powder smoke. It outlives everything else in the show by two orders of
/// magnitude — a puff hangs for a minute or more, spreading and thinning,
/// which is how a real show ends up under a lid of its own smog.
struct Puff {
    var x: Double = 0, y: Double = 0
    var vx: Double = 0, vy: Double = 0
    var z: Double = 1
    var age: Double = 0
    var life: Double = 90
    var r0: Double = 20
    var grow: Double = 90
    var density: Double = 0.08
    var lit: Double = 0          // caught by a nearby break, decays fast
    var aspect: Double = 1       // drawn as an ellipse, for variety
    var phase: Double = 0
    var variant: UInt8 = 0
}

struct Flash {
    var x: Double = 0, y: Double = 0
    var z: Double = 1
    var age: Double = 0
    var life: Double = 0.26
    var radius: Double = 100
    var hue: Double = 0.1
    var silver: Bool = false
    var power: Double = 1
    var spin: Double = 0        // rotation of the sparkle rosette
}

struct Star {
    var ux: Double = 0, uy: Double = 0   // 0...1 screen space
    var bright: Double = 0.4
    var size: Double = 1.6
    var rate: Double = 1.2
    var phase: Double = 0
    var parallax: Double = 0.05          // how far this layer slides with the camera
    var tint: UInt8 = 0                  // 0 silver, 1 warm, 2 cool
    var glint: Bool = false
}

// =====================================================================
// MARK: - Shells
// =====================================================================

enum ShellType: UInt8 {
    case peony          // clean sphere of stars
    case chrysanthemum  // sphere with trails, fading to ember
    case willow         // long, slow, drooping gold
    case palm           // a few fat trunks
    case ring           // a circle in a randomly tilted plane
    case doubleRing     // two perpendicular rings
    case crossette      // stars that break into four
    case strobe         // a shimmering, twinkling ball
    case crackle        // sphere plus a crackling pistil
    case salute         // huge flash, few very fast stars
    case shape          // heart / star outline
    case spiral         // rotating arms
    case multiBreak     // splits into several secondary shells
    case comet          // heavy horsetail
    case cascade        // stars that break, and break, and break again
    case brocade        // long gold rays that glitter the whole way out
}

struct Palette {
    var h0: Double = 0.09
    var h1: Double = 0.55
    var h2: Double = 0.80
    var n: Int = 1
    var jitter: Double = 0.012
    var silverMix: Double = 0
    var rainbow: Bool = false

    func hue(_ r: inout FastRNG) -> Double {
        if rainbow { return r.unit() }
        let pick = n <= 1 ? 0 : r.i(0, n - 1)
        let base = pick == 0 ? h0 : (pick == 1 ? h1 : h2)
        let h = base + r.d(-jitter, jitter)
        return h - floor(h)
    }

    func isSilver(_ r: inout FastRNG) -> Bool { silverMix > 0 && r.unit() < silverMix }

    /// Hues that actually look like fireworks (no muddy olive / khaki).
    static let nice: [Double] = [0.005, 0.030, 0.060, 0.090, 0.120, 0.155,
                                 0.290, 0.340, 0.430, 0.490, 0.530, 0.570,
                                 0.620, 0.690, 0.760, 0.820, 0.880, 0.930, 0.965]

    static func niceHue(_ r: inout FastRNG) -> Double { nice[r.i(0, nice.count - 1)] }

    static func random(_ r: inout FastRNG) -> Palette {
        var p = Palette()
        switch r.i(0, 10) {
        case 0:                                     // single saturated colour
            p.h0 = niceHue(&r); p.n = 1; p.jitter = 0.010
            p.silverMix = r.chance(0.35) ? 0.16 : 0
        case 1:                                     // complementary pair
            let a = niceHue(&r)
            p.h0 = a; p.h1 = (a + 0.5).truncatingRemainder(dividingBy: 1)
            p.n = 2; p.jitter = 0.018
        case 2:                                     // analogous
            let a = niceHue(&r)
            p.h0 = a; p.h1 = a + 0.06; p.h2 = a - 0.06
            p.n = 3; p.jitter = 0.014
        case 3:                                     // triad
            let a = niceHue(&r)
            p.h0 = a; p.h1 = a + 1.0 / 3.0; p.h2 = a + 2.0 / 3.0
            p.n = 3; p.jitter = 0.016
        case 4:                                     // gold & silver
            p.h0 = 0.105; p.n = 1; p.jitter = 0.030; p.silverMix = 0.45
        case 5:                                     // full rainbow
            p.rainbow = true
        case 6:                                     // ice
            p.h0 = 0.560; p.h1 = 0.490; p.n = 2; p.jitter = 0.020; p.silverMix = 0.50
        case 7:                                     // fire
            p.h0 = 0.010; p.h1 = 0.060; p.h2 = 0.110; p.n = 3; p.jitter = 0.020
        case 8:                                     // magenta & cyan
            p.h0 = 0.905; p.h1 = 0.500; p.n = 2; p.jitter = 0.016
        case 9:                                     // pure silver salute
            p.h0 = 0.58; p.n = 1; p.jitter = 0.02; p.silverMix = 1.0
        default:                                    // violet & lime
            p.h0 = 0.760; p.h1 = 0.300; p.n = 2; p.jitter = 0.020
        }
        return p
    }
}

struct ShellPlan {
    var type: ShellType = .peony
    var palette = Palette()
    var z: Double = 1
    var radius: Double = 120
    var count: Int = 120
    var life: Double = 2.0
    var pistil: Bool = false
    var pistilHue: Double = 0.1
    var twinkle: Bool = false
    var glitter: Bool = false
    var trail: Bool = false
    var ember: Bool = false
    var crackle: Bool = false
    var shedRate: Double = 0     // glittering trail, sparks per second per star
    var colorShift: Bool = false
    var shiftHue: Double = 0
    var shiftAt: Double = 0.45   // fraction of life
    var power: Double = 1        // flash / exposure strength
    var generation: Int = 0      // multi-break depth
}

// =====================================================================
// MARK: - Engine
// =====================================================================

final class FireworksEngine {

    /// 0 = dark, 1 = full finale. Written every frame by the view.
    var intensity: Double = 0.32

    let audio = AudioDirector()
    var soundEnabled: Bool = true {
        didSet { if oldValue != soundEnabled { audio.enabled = soundEnabled } }
    }

    func prepareAudio() {
        audio.prepare()
        audio.enabled = soundEnabled
    }

    // Live objects
    private var particles = ContiguousArray<Particle>()
    private var rockets = ContiguousArray<Rocket>()
    private var puffs = ContiguousArray<Puff>()
    private var flashes = ContiguousArray<Flash>()
    private var stars: [Star] = []

    // Timing
    private var lastStamp: TimeInterval = -1
    private var time: Double = 0
    private var dtEMA: Double = 1.0 / 60.0
    private var quality: Double = 1.0

    // Geometry (world units are screen points at z == 1)
    private var canvas: CGSize = .zero
    private var unitH: Double = 1000
    private var unitW: Double = 1000
    private var vanishX: Double = 500
    private var vanishY: Double = 600
    private var groundY: Double = 300

    // Camera
    private var camX: Double = 0
    private var camY: Double = 0
    private var dragX: Double = 0
    private var dragY: Double = 0
    private var dragging = false
    private var driftPhase: Double = 0

    // Show state
    private var nextLaunch: Double = 0.35
    private var exposure: Double = 0
    private var wind: Double = 0
    private var manualTaps: [CGPoint] = []

    private var rng = FastRNG(seed: UInt64(Date().timeIntervalSince1970 * 997) ^ 0x5DEECE66D)

    /// Scale: one world unit is one screen point at z == 1, and an average
    /// shell's burst radius (0.176·H) stands in for about 45 m of real sky.
    /// That puts 1 m at 0.0039·H, so an honest 9.8 m/s² lands right here.
    /// Stars leave the break at ~70 m/s and sag about half a burst radius
    /// over their life, which is what real fireworks do.
    private var gravity: Double { unitH * 0.0383 }

    /// Mortars are the one cheat. At true scale a 200 m climb takes six
    /// seconds, which is a long time to stare at a dot, so the rising comet
    /// gets its own heavier gravity and arcs over in about two. The sparks
    /// it sheds fall at the honest rate, which is the part you actually read.
    private var liftGravity: Double { unitH * 0.30 }

    /// Quadratic drag coefficient for an ordinary star, fixed by its ~20 m/s
    /// terminal fall. Per-particle `drag` is a multiplier on this: below 1 is
    /// a heavy star that sinks faster, above 1 a light one that hangs.
    private var dragUnit: Double { 6.30 / unitH }

    /// The speed a star must leave the break at to open the shell out to
    /// `radius` in `shapeTime` seconds against that drag. Falls out at about
    /// 70 m/s for a normal peony, which is what real stars do.
    private func burstSpeed(_ radius: Double, _ dragMul: Double, _ shapeTime: Double = 1.25) -> Double {
        let k = dragUnit * dragMul
        return (exp(min(3.6, k * radius)) - 1) / (k * max(0.2, shapeTime))
    }

    private var maxParticles: Int { Int(5200 * quality) }

    /// Smoke is fill-rate, not particle count: a few hundred big translucent
    /// quads is the whole budget, so the cap scales with measured frame time
    /// and old puffs — the faintest — are the ones that go.
    private var maxPuffs: Int { Int(60 + 200 * quality * quality) }

    // -----------------------------------------------------------------
    // MARK: Frame
    // -----------------------------------------------------------------

    func advance(to date: Date, size: CGSize) {
        configure(size)

        let stamp = date.timeIntervalSinceReferenceDate
        if lastStamp < 0 { lastStamp = stamp - 1.0 / 60.0 }
        var raw = stamp - lastStamp
        lastStamp = stamp
        if raw <= 0 { raw = 1.0 / 120.0 }
        raw = min(raw, 1.0 / 20.0)          // never let a stall teleport the show

        dtEMA += (raw - dtEMA) * 0.08
        adaptQuality()

        // The slider nudges the clock too: a finale should *feel* faster.
        let dt = raw * (0.92 + clamp01(intensity) * 0.28)
        time += dt

        // Air speed, not a shove. Roughly 1 m/s of drift — a still night.
        wind = unitH * 0.0026 * sin(time * 0.048) + unitH * 0.0013 * sin(time * 0.021 + 1.7)

        stepCamera(dt)
        stepSpawning()
        stepRockets(dt)
        stepParticles(dt)
        stepDecor(dt)
        enforceBudget()
        audio.tick(time)
    }

    private func configure(_ s: CGSize) {
        guard s.width > 1, s.height > 1 else { return }
        guard abs(s.width - canvas.width) > 0.5 || abs(s.height - canvas.height) > 0.5 else { return }
        canvas = s
        unitH = Double(s.height)
        unitW = Double(s.width)
        vanishX = unitW * 0.5
        vanishY = unitH * 0.60          // horizon / vanishing line
        groundY = unitH * 0.30          // camera height above the launch plane
        buildStars()
    }

    private func adaptQuality() {
        if dtEMA > 1.0 / 47.0 {
            quality = max(0.36, quality - 0.012)
        } else if dtEMA < 1.0 / 58.0 {
            quality = min(1.0, quality + 0.004)
        }
    }

    /// Seven discrete sky layers. Each one has its own parallax rate, size and
    /// brightness band, so panning separates them instead of sliding one flat
    /// sheet of dots. Deep layers are dense, dim and nearly fixed; the near
    /// ones are sparse, big and slide noticeably.
    private func buildStars() {
        stars.removeAll(keepingCapacity: true)
        var r = FastRNG(seed: 0xF00D_BEEF)
        let layers = 7
        for l in 0..<layers {
            let f = Double(l) / Double(layers - 1)          // 0 = deepest, 1 = nearest
            let parallax = 0.015 + 0.235 * pow(f, 1.7)
            let count = Int(215 - 160 * f)                  // deep layers are dense dust
            let sizeLo = 0.70 + 1.10 * f                    // 1.4 px across at the back
            let sizeHi = 1.15 + 2.35 * f                    // 7.0 px across at the front
            let brightLo = 0.05 + 0.11 * f
            let brightHi = 0.17 + 0.33 * f
            for _ in 0..<count {
                var st = Star()
                st.ux = r.unit()
                // Past both edges, so a vertical camera drift never exposes a
                // bare band. There is no horizon here — the sky fills the frame.
                st.uy = r.d(-0.05, 1.05)
                st.parallax = parallax
                st.size = r.d(sizeLo, sizeHi)
                st.bright = r.d(brightLo, brightHi)
                // A slow sine each, 7 to 30 seconds a cycle, all out of step.
                st.rate = r.d(0.21, 0.95)
                st.phase = r.d(0, 6.283)
                // Sparkles are rarer, and live mostly on the near layers.
                st.glint = r.chance(0.07 + 0.20 * f)
                if st.glint { st.size *= 1.15; st.bright = min(1, st.bright * 1.25) }
                st.tint = r.chance(0.62) ? 0 : (r.chance(0.5) ? 1 : 2)
                stars.append(st)
            }
        }
    }

    // -----------------------------------------------------------------
    // MARK: Camera — the parallax rig
    // -----------------------------------------------------------------

    func setDrag(dx: Double, dy: Double) {
        dragging = true
        dragX = -dx * 0.55
        dragY = -dy * 0.28
    }

    func endDrag() { dragging = false }

    func requestManualShell(at point: CGPoint) {
        if manualTaps.count < 6 { manualTaps.append(point) }
    }

    private func stepCamera(_ dt: Double) {
        driftPhase += dt
        let drift = sin(driftPhase * 0.061) * unitH * 0.075
                  + sin(driftPhase * 0.131 + 1.2) * unitH * 0.026
        let driftY = sin(driftPhase * 0.047 + 0.4) * unitH * 0.012

        if !dragging {
            let decay = exp(-dt * 0.85)
            dragX *= decay
            dragY *= decay
        }

        let k = 1 - exp(-dt * 5.0)
        camX += ((drift + dragX) - camX) * k
        camY += ((driftY + dragY) - camY) * k
    }

    @inline(__always) private func screenX(_ wx: Double, _ z: Double) -> Double {
        vanishX + (wx - camX) * z
    }
    @inline(__always) private func screenY(_ wy: Double, _ z: Double) -> Double {
        vanishY + (wy - camY) * z
    }
    @inline(__always) private func worldX(_ sx: Double, _ z: Double) -> Double {
        camX + (sx - vanishX) / z
    }
    @inline(__always) private func worldY(_ sy: Double, _ z: Double) -> Double {
        camY + (sy - vanishY) / z
    }

    // In the pinhole rig z is focal/distance, so distance falls off as 1/z.
    // Calibrated so a mid-depth shell sits roughly 250 m out — which is why
    // you see it well before you hear it.
    private func soundDelay(_ z: Double) -> Double {
        min(2.4, (250.0 / max(0.20, z)) / 343.0)
    }
    private func soundLevel(_ z: Double) -> Double {
        0.45 + 0.55 * clamp01((z - 0.70) / 0.62)
    }
    /// Air eats the top end over distance: far shells are all thud, no crack.
    private func soundCutoff(_ z: Double) -> Double {
        1800 + 5200 * clamp01((z - 0.72) / 0.60)
    }
    private func soundPan(_ sx: Double) -> Double {
        max(-1, min(1, ((sx / max(1, unitW)) * 2 - 1) * 0.8))
    }

    /// Distant shells are hazier and dimmer.
    @inline(__always) private func atmosphere(_ z: Double) -> Double {
        0.80 + 0.24 * clamp01((z - 0.72) / 0.60)
    }

    // -----------------------------------------------------------------
    // MARK: Cadence
    // -----------------------------------------------------------------

    private func stepSpawning() {
        while let tap = manualTaps.popLast() {
            launchShell(e: max(0.35, Show.energy(intensity)), target: tap)
        }

        guard intensity > 0.02 else { return }
        guard time >= nextLaunch else { return }

        let e = Show.energy(intensity)
        let volley = 1 + rng.i(0, Int((2.4 * e * e).rounded()))
        for _ in 0..<volley { launchShell(e: e, target: nil) }

        // Finale salvos: a wall of shells straight across the sky.
        if e > 0.84 && rng.chance(0.12) {
            let n = rng.i(4, 9)
            for _ in 0..<n { launchShell(e: e, target: nil) }
        }

        nextLaunch = time + Show.interval(e) * rng.d(0.70, 1.35)
    }

    /// Depth pick. High energy pushes more shells to the near planes so the
    /// finale fills the frame; low energy favours calm, distant singles.
    /// Depth spans a modest 0.72...1.32. Shells still layer and parallax
    /// against each other, but they all read as being fired from the same
    /// field rather than one at your feet and the next on the horizon.
    private func pickDepth(_ e: Double) -> Double {
        let u = rng.unit()
        let near = 0.30 + 0.45 * e
        if rng.unit() < near { return 1.02 + u * 0.30 }         // 1.02 ... 1.32
        return 0.72 + u * 0.30                                  // 0.72 ... 1.02
    }

    private func launchShell(e: Double, target: CGPoint?) {
        guard rockets.count < 80 else { return }

        let z: Double
        let burstSX: Double
        var rawSY: Double

        if let t = target {
            z = rng.d(0.85, 1.25)
            burstSX = Double(t.x)
            rawSY = Double(t.y)
        } else {
            z = pickDepth(e)
            burstSX = unitW * rng.d(0.06, 0.94)
            // Far shells sit nearer the horizon, near shells climb high.
            rawSY = unitH * rng.d(0.08, 0.31) + unitH * 0.07 * (1 - clamp01((z - 0.72) / 0.60))
        }
        rawSY = min(rawSY, vanishY - unitH * 0.04)
        let burstSY = rawSY

        let bx = worldX(burstSX, z)
        let by = worldY(burstSY, z)

        // Launch point on the ground plane, roughly under the break.
        let originSX = burstSX + unitW * rng.d(-0.06, 0.06)
        let ox = worldX(originSX, z)
        let oy = groundY

        // Fuse chosen so the shell breaks exactly at apex.
        let rise = max(unitH * 0.08, oy - by)
        var fuse = (2 * rise / liftGravity).squareRoot()
        fuse *= rng.d(0.95, 1.03)

        var plan = makePlan(e: e, z: z)
        plan.z = z

        var rk = Rocket()
        rk.x = ox
        rk.y = oy
        rk.vy = -liftGravity * fuse
        rk.vx = (bx - ox) / max(0.2, fuse)
        rk.z = z
        rk.fuse = fuse
        rk.hue = plan.palette.hue(&rng)
        rk.silver = rng.chance(0.45)
        rk.size = unitH * 0.0040
        rk.trailRate = rng.d(70, 130)
        rk.plan = plan
        rockets.append(rk)

        // Mortars leave their own bank of smoke sitting on the water.
        if quality > 0.45 && puffs.count < maxPuffs && rng.chance(0.85) {
            var s = Puff()
            s.x = ox + rng.d(-1, 1) * unitH * 0.010
            s.y = oy - unitH * 0.012
            s.vy = -unitH * 0.014
            s.z = z
            s.life = rng.d(60, 150)
            s.r0 = unitH * rng.d(0.012, 0.024)
            s.grow = unitH * rng.d(0.10, 0.19)
            s.density = rng.d(0.035, 0.075)
            s.aspect = rng.d(0.90, 1.55)
            s.phase = rng.d(0, 6.283)
            s.variant = UInt8(rng.i(0, Sprites.smokeVariants - 1))
            s.lit = 0.8
            puffs.append(s)
        }

        // The boof. At full tilt these stack into mush, so thin them out.
        if rng.chance(1.0 - 0.55 * e) {
            audio.schedule(.launch, delay: soundDelay(z),
                           volume: 0.40 * soundLevel(z),
                           pan: soundPan(originSX),
                           cutoff: soundCutoff(z) * 0.8)
        }
    }

    // -----------------------------------------------------------------
    // MARK: Shell design — every shell is rolled fresh
    // -----------------------------------------------------------------

    private func pickType(_ e: Double) -> ShellType {
        let table: [(ShellType, Double)] = [
            (.peony,          1.00),
            (.chrysanthemum,  0.95),
            (.willow,         0.70 - 0.25 * e),
            (.palm,           0.45),
            (.ring,           0.50),
            (.doubleRing,     0.24),
            (.crossette,      0.32 + 0.28 * e),
            (.strobe,         0.42),
            (.crackle,        0.28 + 0.40 * e),
            (.salute,         0.04 + 0.42 * e),
            (.shape,          0.70 - 0.22 * e),
            (.spiral,         0.22),
            (.multiBreak,     0.08 + 0.40 * e),
            (.comet,          0.26),
            (.cascade,        0.26 + 0.12 * e),
            (.brocade,        0.85)
        ]
        var total = 0.0
        for item in table { total += max(0, item.1) }
        var roll = rng.d(0, total)
        for item in table {
            roll -= max(0, item.1)
            if roll <= 0 { return item.0 }
        }
        return .peony
    }

    private func makePlan(e: Double, z: Double) -> ShellPlan {
        var p = ShellPlan()
        p.type = pickType(e)
        p.palette = Palette.random(&rng)

        let scale = rng.d(0.80, 1.30)
        p.radius = unitH * 0.176 * scale
        p.life = rng.d(1.7, 2.5) * (0.85 + 0.35 * scale)
        p.count = Int(rng.d(105, 200) * scale)
        p.twinkle = rng.chance(0.34)
        p.glitter = rng.chance(0.18)
        p.trail = rng.chance(0.40)
        p.ember = rng.chance(0.55)
        p.crackle = rng.chance(0.22)
        p.pistil = rng.chance(0.30)
        p.pistilHue = Palette.niceHue(&rng)
        p.power = 0.55 * scale

        switch p.type {
        case .peony:
            p.trail = rng.chance(0.25)
        case .chrysanthemum:
            p.trail = true; p.ember = true
            p.life *= 1.35; p.count = Int(Double(p.count) * 1.05)
        case .willow:
            p.trail = true; p.ember = true
            p.palette = Palette(h0: 0.095, h1: 0.115, h2: 0.075, n: 3,
                                jitter: 0.02, silverMix: rng.chance(0.3) ? 0.3 : 0.0, rainbow: false)
            p.life = rng.d(3.8, 5.4)
            p.radius *= 0.72
            p.count = Int(Double(p.count) * 0.85)
            p.twinkle = rng.chance(0.5)
        case .palm:
            p.trail = true; p.ember = true
            p.count = Int(Double(p.count) * 0.75)
            p.life *= 1.25
            p.power = 0.8 * scale
        case .ring, .doubleRing:
            p.count = Int(Double(p.count) * 0.60)
            p.trail = rng.chance(0.35)
            p.life *= 1.1
        case .crossette:
            p.count = Int(Double(p.count) * 0.22)
            p.trail = true
            p.life *= 0.75
        case .strobe:
            p.glitter = true; p.twinkle = false; p.trail = false; p.ember = false
            p.life = rng.d(2.6, 3.8)
            p.count = Int(Double(p.count) * 1.1)
        case .crackle:
            p.crackle = true; p.pistil = true
        case .salute:
            p.count = Int(Double(p.count) * 0.35)
            p.life = rng.d(0.55, 0.95)
            p.radius *= 1.15
            p.power = 2.4 * scale
            p.palette.silverMix = max(p.palette.silverMix, 0.7)
            p.trail = false
        case .shape:
            // A figure needs enough stars to join up, and a single colour to
            // read as a drawn line rather than confetti.
            p.count = Int(Double(p.count) * 1.15)
            p.radius *= 1.12
            p.life *= 1.15
            p.trail = false
            p.ember = false
            p.glitter = false
            p.pistil = false
            p.crackle = false
            p.twinkle = rng.chance(0.35)
            p.palette.n = 1
            p.palette.rainbow = false
            p.palette.jitter = 0.008
            p.palette.silverMix = 0
            // Eyes, mouth and whiskers burn in a contrasting colour.
            p.pistilHue = (p.palette.h0 + rng.d(0.34, 0.66)).truncatingRemainder(dividingBy: 1)
        case .spiral:
            p.count = Int(Double(p.count) * 0.7)
            p.trail = true
        case .multiBreak:
            p.count = Int(Double(p.count) * 0.35)
            p.radius *= 0.75
        case .comet:
            p.trail = true; p.ember = true
            p.count = Int(Double(p.count) * 0.8)
            p.radius *= 0.85
            p.life *= 1.4
        case .brocade:
            // The classic glittering gold shell: long straight rays that
            // shed sparks the whole way out and hang there burning.
            p.palette = Palette(h0: 0.095, h1: 0.072, h2: 0.115, n: 3,
                                jitter: 0.016,
                                silverMix: rng.chance(0.40) ? 0.22 : 0.0,
                                rainbow: false)
            p.count = Int(Double(p.count) * 0.42)
            p.life = rng.d(2.7, 3.7)
            p.radius *= 1.05
            p.trail = true
            p.ember = true
            p.glitter = false
            p.twinkle = rng.chance(0.30)
            p.crackle = false
            p.pistil = rng.chance(0.32)
            p.shedRate = rng.d(26, 42)
        case .cascade:
            // Each star ends up as 27, so start with very few.
            p.count = Int(Double(p.count) * 0.13)
            p.radius *= 0.85
            p.life = rng.d(2.7, 3.5)
            p.trail = true
            p.ember = false
            p.pistil = false
        }

        // Any other long-burning shell may glitter too. Sparks are not free,
        // so a shell that sheds carries fewer stars.
        if p.shedRate <= 0 && rng.chance(0.32)
            && (p.type == .chrysanthemum || p.type == .willow
                || p.type == .palm || p.type == .comet) {
            p.shedRate = rng.d(15, 27)
            p.count = Int(Double(p.count) * 0.70)
            p.ember = true
        }

        // Colour-changing stars. Not for figures, which need one colour to
        // stay legible, nor salutes, which are over before they could.
        if p.type != .shape && p.type != .salute && rng.chance(0.22) {
            p.colorShift = true
            p.shiftHue = (p.palette.h0 + rng.d(0.28, 0.72)).truncatingRemainder(dividingBy: 1)
            p.shiftAt = rng.d(0.34, 0.58)
            p.ember = false
        }

        // Density budget: a finale runs many smaller shells, not many huge ones.
        let density = quality * (1.05 - 0.30 * e)
        p.count = max(14, Int(Double(p.count) * density))
        return p
    }

    // -----------------------------------------------------------------
    // MARK: Rockets
    // -----------------------------------------------------------------

    private func stepRockets(_ dt: Double) {
        guard !rockets.isEmpty else { return }
        var index = rockets.count - 1
        while index >= 0 {
            var r = rockets[index]
            r.vy += liftGravity * dt
            r.x += r.vx * dt
            r.y += r.vy * dt
            r.fuse -= dt

            // Burning tail.
            r.trailAccum += r.trailRate * quality * dt
            while r.trailAccum >= 1 {
                r.trailAccum -= 1
                spawnStar(x: r.x + rng.d(-2, 2), y: r.y + rng.d(-2, 2),
                          vx: r.vx * 0.10 + rng.d(-18, 18),
                          vy: r.vy * 0.06 + rng.d(-10, 26),
                          z: r.z, fs: 1,
                          life: rng.d(0.22, 0.60), size: unitH * 0.0020,
                          hue: r.silver ? 0.10 : r.hue,
                          bright: rng.d(0.45, 0.95),
                          drag: 3.0, grav: 0.35, windK: 1.6, decay: 1.9,
                          trail: 0,
                          flags: r.silver ? [.ember, .silver] : [.ember],
                          buoy: 0.55)
            }

            if r.fuse <= 0 || (r.apex && r.vy >= 0) {
                burst(plan: r.plan, x: r.x, y: r.y, vx: r.vx * 0.22, vy: r.vy * 0.22)
                rockets.remove(at: index)
            } else {
                rockets[index] = r
            }
            index -= 1
        }
    }

    // -----------------------------------------------------------------
    // MARK: Star factory
    // -----------------------------------------------------------------

    private func spawnStar(x: Double, y: Double, vx: Double, vy: Double,
                           z: Double, fs: Double,
                           life: Double, size: Double, hue: Double, bright: Double,
                           drag: Double, grav: Double, windK: Double, decay: Double,
                           trail: UInt8, flags: PFlags,
                           splitAge: Double = -1, splitSpeed: Double = 0,
                           splitHue: Double = -1, jitter: Double = 0,
                           buoy: Double = 0.30,
                           splitsLeft: UInt8 = 0, splitGap: Double = 0.45,
                           splitFan: UInt8 = 4,
                           hue2: Double = -1, hueShiftAt: Double = -1,
                           shed: Double = 0) {
        guard particles.count < maxParticles else { return }
        var p = Particle()
        p.x = x; p.y = y; p.vx = vx; p.vy = vy
        p.z = z; p.fs = fs
        p.life = life; p.size = size; p.hue = hue; p.bright = bright
        p.drag = drag; p.grav = grav; p.windK = windK; p.decay = decay; p.buoy = buoy
        p.trail = trail; p.flags = flags
        p.splitAge = splitAge; p.splitSpeed = splitSpeed; p.splitHue = splitHue
        p.splitsLeft = splitsLeft; p.splitGap = splitGap; p.splitFan = splitFan
        p.hue2 = hue2; p.hueShiftAt = hueShiftAt
        p.shed = shed
        p.jitter = jitter
        p.phase = rng.d(0, 6.283)
        p.rate = rng.d(9, 27)
        particles.append(p)
    }

    /// Shared per-star roll used by every burst shape.
    private func starFlags(_ plan: ShellPlan, silver: Bool) -> PFlags {
        var f: PFlags = []
        if silver { f.insert(.silver) }
        if plan.ember { f.insert(.ember) }
        if plan.glitter {
            f.insert(.glitter)
        } else if plan.twinkle && rng.chance(0.55) {
            f.insert(.twinkle)
        }
        return f
    }

    // -----------------------------------------------------------------
    // MARK: The break
    // -----------------------------------------------------------------

    private func emitStar(_ plan: ShellPlan, x: Double, y: Double, bvx: Double, bvy: Double,
                          dir: V3, speed: Double, life: Double, size: Double,
                          drag: Double, grav: Double, decay: Double, trail: UInt8,
                          extra: PFlags = [], hueOverride: Double = -1,
                          splitAge: Double = -1, splitSpeed: Double = 0, splitHue: Double = -1,
                          jitter: Double = 0, brightScale: Double = 1, windK: Double = 1,
                          buoy: Double = 0.30,
                          splitsLeft: UInt8 = 0, splitGap: Double = 0.45,
                          splitFan: UInt8 = 4,
                          shed: Double = -1) {
        let silver = plan.palette.isSilver(&rng)
        var flags = starFlags(plan, silver: silver)
        flags.formUnion(extra)
        let hue = hueOverride >= 0 ? hueOverride : plan.palette.hue(&rng)
        // The third dimension never moves the star on screen — it only changes
        // how big and how bright it reads. That is the whole 2.5D trick.
        let fs = 1 + dir.z * 0.30
        let realLife = life * rng.d(0.84, 1.16)
        // Colour-changing stars burn through to a second composition partway
        // down, which is a real trick and a lovely one.
        var h2 = -1.0
        var shiftAt = -1.0
        if plan.colorShift {
            h2 = plan.shiftHue + rng.d(-0.012, 0.012)
            shiftAt = realLife * plan.shiftAt * rng.d(0.92, 1.08)
        }
        spawnStar(x: x, y: y,
                  vx: bvx + dir.x * speed,
                  vy: bvy + dir.y * speed,
                  z: plan.z, fs: fs,
                  life: realLife,
                  size: size,
                  hue: hue,
                  bright: rng.d(0.82, 1.12) * brightScale,
                  drag: drag, grav: grav, windK: windK, decay: decay,
                  trail: trail, flags: flags,
                  splitAge: splitAge, splitSpeed: splitSpeed, splitHue: splitHue,
                  jitter: jitter, buoy: buoy,
                  splitsLeft: splitsLeft, splitGap: splitGap, splitFan: splitFan,
                  hue2: h2, hueShiftAt: shiftAt,
                  shed: shed < 0 ? plan.shedRate : shed)
    }

    /// How far a star strays from a line it is supposed to be on. Enough that
    /// a figure reads as drawn rather than plotted; not enough to blur what it
    /// is. Anything laid out on exact geometry — a figure, a ring, a spiral —
    /// goes through here, or it looks printed.
    private static let figureWobble = 0.021

    @inline(__always) private func scatter(_ d: V3) -> V3 {
        let w = Self.figureWobble
        return V3(x: d.x + rng.d(-w, w),
                  y: d.y + rng.d(-w, w),
                  z: d.z + rng.d(-w * 0.7, w * 0.7))
    }

    @inline(__always) private func randomDir(_ r: inout FastRNG) -> V3 {
        let u = r.d(-1, 1)
        let a = r.d(0, 6.2831853)
        let s = (max(0, 1 - u * u)).squareRoot()
        return V3(x: s * cos(a), y: s * sin(a), z: u)
    }

    private func burst(plan: ShellPlan, x: Double, y: Double, vx: Double, vy: Double) {
        let baseSize = unitH * 0.0034
        let atmos = atmosphere(plan.z)

        // Break flash + camera exposure lift.
        flashes.append(Flash(x: x, y: y, z: plan.z, age: 0,
                             life: plan.type == .salute ? 0.42 : 0.32,
                             radius: plan.radius * 0.55,
                             hue: plan.palette.hue(&rng),
                             silver: plan.type == .salute,
                             power: plan.power,
                             spin: rng.d(0, 6.283)))
        exposure = min(1.6, exposure + plan.power * 0.22 * atmos)

        // Heard well after it is seen.
        let delay = soundDelay(plan.z)
        let level = soundLevel(plan.z)
        let pan = soundPan(screenX(x, plan.z))
        let cutoff = soundCutoff(plan.z)
        let punch = min(1.35, 0.55 + plan.power * 0.45) * (plan.generation > 0 ? 0.55 : 1.0)
        audio.schedule(plan.type == .salute ? .crack : .boom,
                       delay: delay, volume: level * punch, pan: pan, cutoff: cutoff)
        if plan.crackle || plan.type == .crossette || plan.type == .multiBreak {
            audio.schedule(.crackle, delay: delay + rng.d(0.04, 0.14),
                           volume: level * 0.55, pan: pan, cutoff: cutoff * 1.1)
        }
        if plan.glitter || plan.type == .strobe || (plan.twinkle && rng.chance(0.5)) {
            audio.schedule(.shimmer, delay: delay + rng.d(0.05, 0.20),
                           volume: level * 0.42, pan: pan, cutoff: cutoff * 1.2)
        }

        // Powder smoke. Born inside the flash, so it starts lit.
        if quality > 0.35 && puffs.count < maxPuffs {
            let n = plan.type == .salute ? 4 : 3
            for _ in 0..<n {
                var s = Puff()
                s.x = x + rng.d(-1, 1) * plan.radius * 0.30
                s.y = y + rng.d(-1, 1) * plan.radius * 0.30
                s.vx = rng.d(-1, 1) * plan.radius * 0.10
                s.vy = rng.d(-1, 1) * plan.radius * 0.08 - plan.radius * 0.05
                s.z = plan.z
                s.life = rng.d(55, 145)
                s.r0 = plan.radius * rng.d(0.16, 0.28)
                s.grow = plan.radius * rng.d(0.90, 1.70)
                s.density = rng.d(0.055, 0.105) * min(1.6, plan.power) * atmos
                s.aspect = rng.d(0.80, 1.30)
                s.phase = rng.d(0, 6.283)
                s.variant = UInt8(rng.i(0, Sprites.smokeVariants - 1))
                s.lit = 1.1
                puffs.append(s)
            }
        }

        // Smoke already hanging in the air catches the light of this break.
        // This is most of what sells it: smoke at night is only ever as
        // visible as whatever happens to be lighting it.
        if !puffs.isEmpty {
            let reach = plan.radius * 3.4
            let reach2 = reach * reach
            for i in puffs.indices {
                let dx = puffs[i].x - x
                let dy = puffs[i].y - y
                let d2 = dx * dx + dy * dy
                if d2 > reach2 { continue }
                let f = 1 - (d2 / reach2).squareRoot()
                puffs[i].lit = min(2.0, puffs[i].lit + f * f * plan.power * 1.05)
            }
        }

        switch plan.type {

        case .peony, .chrysanthemum:
            let chrys = plan.type == .chrysanthemum
            let trail: UInt8 = plan.trail ? (chrys ? 3 : 2) : 0
            let dm = chrys ? 0.88 : 1.0
            let v = burstSpeed(plan.radius, dm, chrys ? 1.45 : 1.20)
            for _ in 0..<plan.count {
                let d = randomDir(&rng)
                emitStar(plan, x: x, y: y, bvx: vx, bvy: vy, dir: d,
                         speed: v * rng.d(0.90, 1.06),
                         life: plan.life, size: baseSize,
                         drag: dm, grav: 1.0, decay: 1.7, trail: trail)
            }

        case .willow:
            let willowV = burstSpeed(plan.radius, 0.50, 1.80)
            for _ in 0..<plan.count {
                var d = randomDir(&rng)
                d.y = d.y * 0.72 + 0.22            // droop
                emitStar(plan, x: x, y: y, bvx: vx, bvy: vy, dir: d,
                         speed: willowV * rng.d(0.78, 1.10),
                         life: plan.life, size: baseSize * 1.25,
                         drag: 0.50, grav: 1.15, decay: 1.15, trail: 3,
                         windK: 1.4, buoy: 0.16)
            }

        case .palm:
            let palmV = burstSpeed(plan.radius, 0.55, 1.50)
            let trunks = rng.i(8, 13)
            for t in 0..<trunks {
                let a = Double(t) / Double(trunks) * 6.2831853 + rng.d(-0.12, 0.12)
                let tilt = rng.d(-0.8, 0.8)
                let per = max(3, plan.count / trunks)
                for k in 0..<per {
                    let f = Double(k) / Double(per)
                    let jitterA = a + rng.d(-0.07, 0.07)
                    let d = V3(x: cos(jitterA), y: sin(jitterA) * 0.92 - 0.06, z: tilt + rng.d(-0.12, 0.12))
                    emitStar(plan, x: x, y: y, bvx: vx, bvy: vy, dir: d,
                             speed: palmV * (0.55 + 0.60 * f),
                             life: plan.life * (0.7 + 0.6 * f), size: baseSize * 1.35,
                             drag: 0.55, grav: 1.10, decay: 1.25, trail: 3)
                }
            }

        case .ring, .doubleRing:
            emitRing(plan, x: x, y: y, vx: vx, vy: vy, radius: plan.radius,
                     count: plan.count, size: baseSize, drag: 1.0)
            if plan.type == .doubleRing {
                emitRing(plan, x: x, y: y, vx: vx, vy: vy, radius: plan.radius * 0.92,
                         count: plan.count, size: baseSize, drag: 1.0)
            }

        case .crossette:
            let splitHue = Palette.niceHue(&rng)
            let crossV = burstSpeed(plan.radius, 0.90, 1.00)
            let childV = burstSpeed(plan.radius * 0.35, 1.30, 0.55)
            for _ in 0..<plan.count {
                let d = randomDir(&rng)
                emitStar(plan, x: x, y: y, bvx: vx, bvy: vy, dir: d,
                         speed: crossV * rng.d(0.92, 1.05),
                         life: plan.life, size: baseSize * 1.15,
                         drag: 0.90, grav: 0.95, decay: 1.4, trail: 3,
                         splitAge: rng.d(0.38, 0.60),
                         splitSpeed: childV,
                         splitHue: rng.chance(0.6) ? splitHue : -1)
            }

        case .strobe:
            let strobeV = burstSpeed(plan.radius, 1.30, 1.20)
            for _ in 0..<plan.count {
                let d = randomDir(&rng)
                emitStar(plan, x: x, y: y, bvx: vx, bvy: vy, dir: d,
                         speed: strobeV * rng.d(0.88, 1.08),
                         life: plan.life, size: baseSize * 1.1,
                         drag: 1.30, grav: 0.90, decay: 0.55, trail: 0,
                         extra: [.glitter], brightScale: 1.25, buoy: 0.42)
            }

        case .crackle:
            let crackV = burstSpeed(plan.radius, 1.0, 1.20)
            for _ in 0..<plan.count {
                let d = randomDir(&rng)
                emitStar(plan, x: x, y: y, bvx: vx, bvy: vy, dir: d,
                         speed: crackV * rng.d(0.90, 1.06),
                         life: plan.life, size: baseSize,
                         drag: 1.0, grav: 1.0, decay: 1.7,
                         trail: plan.trail ? 2 : 0)
            }

        case .salute:
            let saluteV = burstSpeed(plan.radius, 1.20, 0.80)
            for _ in 0..<plan.count {
                let d = randomDir(&rng)
                emitStar(plan, x: x, y: y, bvx: vx, bvy: vy, dir: d,
                         speed: saluteV * rng.d(0.75, 1.15),
                         life: plan.life, size: baseSize * 1.1,
                         drag: 1.20, grav: 0.90, decay: 2.6, trail: 2,
                         brightScale: 1.4)
            }

        case .shape:
            emitOutline(plan, x: x, y: y, vx: vx, vy: vy, size: baseSize)

        case .spiral:
            let spiralV = burstSpeed(plan.radius, 1.0, 1.25)
            let arms = rng.i(2, 4)
            let turns = rng.d(0.55, 1.10)
            let tilt = rng.d(-0.7, 0.7)
            let per = max(6, plan.count / arms)
            for arm in 0..<arms {
                let a0 = Double(arm) / Double(arms) * 6.2831853
                for k in 0..<per {
                    let f = Double(k) / Double(per)
                    let a = a0 + f * turns * 6.2831853
                    let d = scatter(V3(x: cos(a), y: sin(a), z: tilt * (1 - f)))
                    emitStar(plan, x: x, y: y, bvx: vx, bvy: vy, dir: d,
                             speed: spiralV * (0.25 + 0.85 * f) * rng.d(0.984, 1.016),
                             life: plan.life * (0.75 + 0.4 * f), size: baseSize,
                             drag: rng.d(0.955, 1.045),
                             grav: 0.95 * rng.d(0.94, 1.06), decay: 1.5, trail: 2)
                }
            }

        case .multiBreak:
            let breakV = burstSpeed(plan.radius, 1.20, 0.70)
            for _ in 0..<plan.count {
                let d = randomDir(&rng)
                emitStar(plan, x: x, y: y, bvx: vx, bvy: vy, dir: d,
                         speed: breakV * rng.d(0.85, 1.05),
                         life: plan.life * 0.55, size: baseSize * 0.9,
                         drag: 1.20, grav: 1.0, decay: 2.0, trail: 2)
            }
            if plan.generation < 1 && rockets.count < 80 {
                let subs = rng.i(3, 6)
                for s in 0..<subs {
                    var sub = plan
                    sub.generation = plan.generation + 1
                    sub.type = rng.chance(0.35) ? .crackle : (rng.chance(0.5) ? .peony : .strobe)
                    sub.radius = plan.radius * rng.d(0.42, 0.62)
                    sub.count = max(18, Int(Double(plan.count) * rng.d(0.7, 1.1)))
                    sub.life = rng.d(1.3, 2.1)
                    sub.power = plan.power * 0.5
                    if rng.chance(0.6) { sub.palette = Palette.random(&rng) }

                    let a = Double(s) / Double(subs) * 6.2831853 + rng.d(-0.3, 0.3)
                    let sp = plan.radius * rng.d(1.5, 2.2)
                    var rk = Rocket()
                    rk.x = x; rk.y = y
                    rk.vx = vx + cos(a) * sp
                    rk.vy = vy + sin(a) * sp * 0.8 - plan.radius * 0.35
                    rk.z = plan.z
                    rk.fuse = rng.d(0.45, 0.85)
                    rk.hue = sub.palette.hue(&rng)
                    rk.silver = rng.chance(0.5)
                    rk.size = unitH * 0.0028
                    rk.trailRate = 60
                    rk.apex = false
                    rk.plan = sub
                    rockets.append(rk)
                }
            }

        case .brocade:
            // Low drag so the rays run long and straight, and a slow decay so
            // the head is still burning when it gets there.
            let brocV = burstSpeed(plan.radius, 0.62, 1.55)
            for _ in 0..<plan.count {
                let d = randomDir(&rng)
                emitStar(plan, x: x, y: y, bvx: vx, bvy: vy, dir: d,
                         speed: brocV * rng.d(0.92, 1.05),
                         life: plan.life, size: baseSize * 1.15,
                         drag: 0.62, grav: 1.02, decay: 0.95, trail: 1,
                         buoy: 0.22)
            }

        case .cascade:
            let cascV = burstSpeed(plan.radius, 0.95, 1.00)
            let gap = rng.d(0.40, 0.60)
            let childV = burstSpeed(plan.radius * 0.30, 1.30, 0.50)
            let childHue = rng.chance(0.70) ? Palette.niceHue(&rng) : -1
            for _ in 0..<plan.count {
                let d = randomDir(&rng)
                emitStar(plan, x: x, y: y, bvx: vx, bvy: vy, dir: d,
                         speed: cascV * rng.d(0.90, 1.05),
                         life: plan.life, size: baseSize * 1.20,
                         drag: 0.95, grav: 0.95, decay: 1.25, trail: 3,
                         splitAge: gap * rng.d(0.92, 1.08),
                         splitSpeed: childV,
                         splitHue: childHue,
                         splitsLeft: 2, splitGap: gap, splitFan: 3)
            }

        case .comet:
            let cometV = burstSpeed(plan.radius, 0.45, 1.90)
            let a0 = rng.d(0, 6.2831853)
            for _ in 0..<plan.count {
                var d = randomDir(&rng)
                d.y = d.y * 0.55 + 0.35
                d.x = d.x * 0.85 + cos(a0) * 0.1
                emitStar(plan, x: x, y: y, bvx: vx, bvy: vy, dir: d,
                         speed: cometV * rng.d(0.60, 1.15),
                         life: plan.life, size: baseSize * 1.45,
                         drag: 0.45, grav: 1.25, decay: 1.0, trail: 3,
                         windK: 1.5, buoy: 0.14)
            }
        }

        // Inner pistil of a contrasting colour.
        if plan.pistil && plan.type != .salute && plan.type != .multiBreak {
            var inner = plan
            inner.palette = Palette(h0: plan.pistilHue, h1: plan.pistilHue, h2: plan.pistilHue,
                                    n: 1, jitter: 0.02,
                                    silverMix: rng.chance(0.3) ? 0.3 : 0, rainbow: false)
            let n = max(10, Int(Double(plan.count) * 0.30))
            let pistilV = burstSpeed(plan.radius * 0.55, 1.10, 1.00)
            for _ in 0..<n {
                let d = randomDir(&rng)
                emitStar(inner, x: x, y: y, bvx: vx, bvy: vy, dir: d,
                         speed: pistilV * rng.d(0.85, 1.05),
                         life: plan.life * 0.8, size: baseSize * 0.95,
                         drag: 1.10, grav: 1.0, decay: 1.8, trail: 0,
                         shed: 0)
            }
        }

        // Crackling pistil: tiny, short-lived, violently flickering sparks.
        if plan.crackle {
            let n = max(14, Int(Double(plan.count) * 0.35 * quality))
            let sparkV = burstSpeed(plan.radius * 0.45, 2.40, 0.50)
            for _ in 0..<n {
                let d = randomDir(&rng)
                emitStar(plan, x: x, y: y, bvx: vx, bvy: vy, dir: d,
                         speed: sparkV * rng.d(0.25, 1.00),
                         life: rng.d(0.35, 0.85), size: baseSize * 0.8,
                         drag: 2.40, grav: 0.8, decay: 1.0, trail: 0,
                         extra: [.glitter, .silver, .noHalo],
                         jitter: unitH * 0.5, brightScale: 1.3, buoy: 0.48,
                         shed: 0)
            }
        }
    }

    private func emitRing(_ plan: ShellPlan, x: Double, y: Double, vx: Double, vy: Double,
                          radius: Double, count: Int, size: Double, drag: Double) {
        // A circle living in a randomly oriented 3D plane: on screen it reads
        // as an ellipse of any tilt, which is what sells the depth.
        let nz = rng.d(-1, 1)
        let na = rng.d(0, 6.2831853)
        let ns = (max(0, 1 - nz * nz)).squareRoot()
        let n = V3(x: ns * cos(na), y: ns * sin(na), z: nz)
        let t = abs(n.z) > 0.9 ? V3(x: 1, y: 0, z: 0) : V3(x: 0, y: 0, z: 1)
        let e1 = normalized(cross(n, t))
        let e2 = normalized(cross(n, e1))
        let phase = rng.d(0, 6.2831853)
        let trail: UInt8 = plan.trail ? 2 : 0
        let v = burstSpeed(radius, drag, 1.15)

        for k in 0..<count {
            let a = Double(k) / Double(count) * 6.2831853 + phase + rng.d(-0.010, 0.010)
            let ca = cos(a), sa = sin(a)
            let d = scatter(V3(x: e1.x * ca + e2.x * sa,
                               y: e1.y * ca + e2.y * sa,
                               z: e1.z * ca + e2.z * sa))
            emitStar(plan, x: x, y: y, bvx: vx, bvy: vy, dir: d,
                     speed: v * rng.d(0.984, 1.016),
                     life: plan.life, size: size,
                     drag: drag * rng.d(0.955, 1.045),
                     grav: rng.d(0.94, 1.06), decay: 1.6, trail: trail)
        }
    }

    private func emitOutline(_ plan: ShellPlan, x: Double, y: Double,
                             vx: Double, vy: Double, size: Double) {
        let kind = rng.i(0, 9)
        var o = Outline()
        o.reserve(plan.count)
        let n = plan.count

        switch kind {
        case 0: Outline.heart(&o, n)
        case 1: Outline.star5(&o, n)
        case 2: Outline.flower(&o, n, petals: rng.i(4, 7))
        case 3: Outline.cat(&o, n)
        case 4: Outline.smiley(&o, n)
        case 5: Outline.bone(&o, n)
        case 6: Outline.peace(&o, n)
        case 7: Outline.person(&o, n)
        case 8: Outline.bear(&o, n)
        default: Outline.paw(&o, n)
        }

        // A figure has an up and a front; a rosette does not. Keep the
        // recognisable ones close to upright and facing the audience.
        let figure = kind != 1 && kind != 2
        let tilt = figure ? rng.d(-0.26, 0.26) : rng.d(-0.55, 0.55)
        let spin = figure ? rng.d(-0.09, 0.09) : rng.d(-0.35, 0.35)
        let ct = cos(tilt), st = sin(tilt)
        let cs = cos(spin), ss = sin(spin)

        let shapeV = burstSpeed(plan.radius, 1.0, 1.30)
        let detailHue = plan.pistilHue

        // A hand is not a plotter. Every star gets a little scatter off the
        // line, and each one flies slightly differently — a touch of spread in
        // how hard the air holds it and how heavy it is — so the figure opens
        // up a fraction over its life instead of hanging there stamped out.
        // Tight enough to be unmistakable, loose enough to look real.
        for i in 0..<o.pts.count {
            let p = o.pts[i]
            let rx = p.0 * cs - p.1 * ss
            let ry = p.0 * ss + p.1 * cs
            let d = scatter(V3(x: rx * ct, y: ry, z: rx * st))
            let isDetail = o.detail[i]
            emitStar(plan, x: x, y: y, bvx: vx, bvy: vy, dir: d,
                     speed: shapeV * rng.d(0.984, 1.016),
                     life: plan.life * 1.1, size: size * (isDetail ? 1.15 : 1.05),
                     drag: rng.d(0.955, 1.045),
                     grav: 0.85 * rng.d(0.925, 1.075),
                     decay: 1.5, trail: 0,
                     hueOverride: isDetail ? detailHue : -1,
                     brightScale: isDetail ? 1.25 : 1.1)
        }
    }

